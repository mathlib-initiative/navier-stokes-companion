{
  "schema": "formal-companion/overlay-config",
  "schema_version": 1,
  "source_id": "openai-navier-stokes-2026",
  "title": "Navier–Stokes source/formalization viewer",
  "lede": "The paper's numbered items and displayed equations, and the Lean declarations a machine audit paired them with. Unconfirmed: not reviewed by a PDE expert.",
  "display": {
    "strip_prefix": "NavierStokes.",
    "minimal": true
  },
  "storage_key": "navier-stokes-viewer-page",
  "pdf": {
    "file_name": "navier-stokes.pdf",
    "cache_dir": ".lake/official-pdf",
    "route": "/__overlay_pdf__/navier-stokes.pdf",
    "remote": true
  },
  "site": {
    "output_root": "site",
    "index": "index.html",
    "mount": "pdf-overlay",
    "link_text": "Open the source/formalization viewer"
  },
  "build": {
    "commands": []
  },
  "serve": {
    "host": "127.0.0.1",
    "port": 8000
  }
}
