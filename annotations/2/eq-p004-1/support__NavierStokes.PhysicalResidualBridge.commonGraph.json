        "line": 406,
        "text": "noncomputable def commonGraph (Q h : ℝ) (i : ℕ) : ScaledGraph where radialScale := Q ^ (-(1/2 : ℝ)); velocityScale := Q ^ (-CoordinateAlgebra.A h); epsilon := Q ^ h  -- the reciprocal scales 1/ℓ_r, and commonGraph_axialScale: radialScale * epsilon = Q ^ (-D h) = 1/ℓ_z"
