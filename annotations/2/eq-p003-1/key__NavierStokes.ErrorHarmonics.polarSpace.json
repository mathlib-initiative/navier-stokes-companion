        "text": "/-- Cartesian location of the cylindrical point `(r,z,θ)`. -/ noncomputable def polarSpace (r z θ : ℝ) : Space := AxisymmetricResidual.pack (r * Real.cos θ) (r * Real.sin θ) z  -- a second, equally exact copy of the same chart, with the arguments ordered (r,z,θ)"
