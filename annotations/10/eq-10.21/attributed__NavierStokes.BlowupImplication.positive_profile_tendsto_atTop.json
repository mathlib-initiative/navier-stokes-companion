            "line": 37,
            "text": "theorem positive_profile_tendsto_atTop {ι : Type*} {l : Filter ι}\n    {q error : ι → ℝ} {A E : ℝ} (hA : 0 < A) (hE : 0 < E)\n    (hq : Tendsto q l (𝓝[>] (0 : ℝ)))\n    (herror : Tendsto error l (𝓝 0)) :\n    Tendsto (fun t => q t ^ (-A) * (E + error t)) l atTop"
          }
