          "snippet": {
            "line": 539,
            "text": "theorem neg_coupling_le_energy {u v : VelocityField} {t B : ℝ}\n    (hu : ContDiff ℝ ∞ (fun x : Space => u (t, x)))\n    (hv : ContDiff ℝ ∞ (fun x : Space => v (t, x)))\n    (hB : ∀ y ∈ cube, ‖spatialDerivative u t (toSpace y)‖ ≤ B) :\n    -coupling u (u - v) t ≤ B * energy u v t"
          }
        }
      }
    }
