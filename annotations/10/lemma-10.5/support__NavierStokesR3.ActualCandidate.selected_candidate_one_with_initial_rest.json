            "text": "theorem selected_candidate_one_with_initial_rest :\n    ∃ u : VelocityField, ∃ p : PressureField, ∃ f : VelocityField, ∃ K : Set Space,\n      ProblemStatement.CandidateProperties 1 u p f K ∧\n        ∀ t : ℝ, |t| ≤ 3 / 8 → ∀ x : Space,\n          u (t, x) = 0 ∧ p (t, x) = 0"
