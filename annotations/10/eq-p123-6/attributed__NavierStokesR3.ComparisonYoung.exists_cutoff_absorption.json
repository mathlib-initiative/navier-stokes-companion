          "snippet": {
            "line": 148,
            "text": "theorem exists_cutoff_absorption {C δ : ℝ} (hC : 0 ≤ C) (hδ : 0 < δ) :\n    ∃ D ≥ 0, ∀ A ≥ 0, ∀ R ≥ 1,\n      C * ((A + R⁻¹) ^ (1 / 2 : ℝ) + 1) *\n          (R⁻¹ * A + R ^ (-2 : ℝ)) +\n        C * R ^ (-7 / 4 : ℝ) * (A + R⁻¹) ^ (3 / 4 : ℝ) +\n        C * R⁻¹ * (A + R⁻¹) ^ (3 / 2 : ℝ) ≤\n          δ * A ^ 2 + D / R"
          }
        }
