            "line": 74,
            "text": "theorem heatCommutatorKernel_bound (i j : Fin 3) {φ : Space → ℝ} {L R : ℝ}\n    (hR : 0 < R) (hφ : ∀ x, φ x ∈ Icc (0 : ℝ) 1)\n    (hLip : ∀ x y, |φ x - φ y| ≤ (L / R) * ‖x - y‖) (x y : Space) :\n    ‖heatCommutatorKernel i j φ x y‖ ≤\n      (heatKernelTimeConstant * max (2 * L) 1) * radialCommutatorKernel R (x - y)"
          }
        }
