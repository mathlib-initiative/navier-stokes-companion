          "snippet": {
            "line": 55,
            "text": "theorem spatialDivergence_sub {u v : VelocityField} {t : ℝ}\n    (hu : ContDiff ℝ ∞ (fun x : Space => u (t, x)))\n    (hv : ContDiff ℝ ∞ (fun x : Space => v (t, x))) (x : Space) :\n    spatialDivergence (u - v) t x = spatialDivergence u t x - spatialDivergence v t x"
          }
        }
