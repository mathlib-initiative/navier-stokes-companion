          "snippet": {
            "line": 405,
            "text": "theorem heatPressure_formula (C h : ℝ) {p : PhysicalPoint} (hs : 0 < p.2.1) :\n    heatPressure C h p =\n      -(C ^ 2 / 2) * p.2.1 ^ (-2 * TerminalPressure.amplitudeExponent h) *\n        TerminalPressure.heatPressureFactor h ((1 - p.1) / p.2.1)"
          }
