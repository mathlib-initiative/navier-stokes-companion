          "relation": "states",
          "snippet": {
            "line": 97,
            "text": "theorem tensorDiff_eq (u v : VelocityField) (t : ℝ) (i j : Fin 3) (x : Space) :\n    tensorDiff u v t i j x =\n      u (t, x) i * (u - v) (t, x) j +\n        (u - v) (t, x) i * u (t, x) j -\n        (u - v) (t, x) i * (u - v) (t, x) j"
          }
        }
      }
