          "snippet": {
            "line": 136,
            "text": "theorem periodize_locally_eq_sum {r : ℝ} {f : SpaceTime → V}\n    (hf : SupportedInCube r f) (z : SpaceTime) :\n    ∃ N : ℕ, periodize f =ᶠ[𝓝 z]\n      (fun w => ∑ n ∈ latticeBoxFinset N, translate f n w)"
          }
        }
      }
