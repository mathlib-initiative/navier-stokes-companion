      "snippet": {
        "line": 200,
        "text": "theorem cutVelocity_product_rule (A : VelocityField) (t : ℝ) (x : Space) (hA : DifferentiableAt ℝ (fun y => A (t, y)) x) : cutVelocity A (t, x) = spatialCutoff x • SpatialCurl.spatialCurl A (t, x) + SpatialCurl.curlLinear ((fderiv ℝ spatialCutoff x).smulRight (A (t, x)))"
      }
