            "text": "theorem periodicVelocity_divergence_free {A : VelocityField} {times : Set ℝ}\n    (hA : ContDiffOn ℝ ∞ A (times ×ˢ (univ : Set Space))) {t : ℝ}\n    (ht : t ∈ times) (x : Space) : spatialDivergence (periodicVelocity A) t x = 0"
