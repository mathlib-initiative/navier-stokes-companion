            "line": 26,
            "text": "theorem theorem_1_1_with_initial_rest (ν : ℝ) (hν : 0 < ν) :\n    ∃ u : VelocityField, ∃ p : PressureField, ∃ f : VelocityField, ∃ K : Set Space,\n      CandidateProperties ν u p f K ∧\n      ¬ Nonempty (GlobalFiniteEnergySolution ν f) ∧\n      ∀ t : ℝ, |t| ≤ 3 / 8 → ∀ x : Space,\n        u (t, x) = 0 ∧ p (t, x) = 0"
