          "snippet": {
            "line": 94,
            "text": "def SpeedUnboundedAtOne (u : VelocityField) : Prop :=\n  ∀ M : ℝ, 0 < M → ∀ δ : ℝ, 0 < δ →\n    ∃ t : ℝ, ∃ x : Space, t ∈ Ioo 0 1 ∧ 1 - δ < t ∧ M < ‖u (t, x)‖"
          }
        }
