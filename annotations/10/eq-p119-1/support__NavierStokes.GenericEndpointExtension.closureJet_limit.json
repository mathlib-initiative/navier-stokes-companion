            "line": 476,
            "text": "theorem closureJet_limit {s : Set Y} {f : Y → V}\n    (hs : IsOpen s) (hc : Convex ℝ s) (hf : ContDiffOn ℝ ∞ f s)\n    (hb : ∀ n : ℕ, ∃ C : ℝ, ∀ x ∈ s, ‖iteratedFDeriv ℝ n f x‖ ≤ C)\n    (n : ℕ) {x : Y} (hx : x ∈ closure s) :\n    Tendsto (iteratedFDeriv ℝ n f) (𝓝[s] x) (𝓝 (closureJet s f n x))"
          }
        }
      }
    }
  ]
