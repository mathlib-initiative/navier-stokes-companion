      "snippet": {
        "line": 44,
        "text": "theorem jet_decay {S : Set Space} (hS : IsCompact S) {f : VelocityField}\n    (hf : ContDiffOn ℝ ∞ f futureDomain) (hs : SupportedIn S f)\n    (htime : CompactFutureTimeSupport f) (m : ℕ) (K : ℝ) :\n    ∃ C : ℝ, 0 < C ∧ ∀ t : ℝ, 0 ≤ t → ∀ x : Space,\n      ‖iteratedFDerivWithin ℝ m f futureDomain (t, x)‖ ≤ C / (1 + ‖x‖ + t) ^ K"
      }
    }
  }
}
