            "text": "theorem translate_eq_zero_on_innerCube {r : ℝ} {f : SpaceTime → V}\n    (hf : SupportedInCube r f) {x : Space} (hx : x ∈ innerCube r)\n    (t : ℝ) {n : Lattice} (hn : n ≠ 0) : translate f n (t, x) = 0"
