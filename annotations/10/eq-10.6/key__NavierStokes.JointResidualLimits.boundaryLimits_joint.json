            "text": "theorem boundaryLimits_joint {f : SpaceTime → V} (hzero : VanishingJointJets f)\n    (hext : AwayExtensions f) (n : ℕ) (x : Space) :\n    Tendsto (iteratedFDeriv ℝ n f) (𝓝[SpacetimeEndpoint.openPast 1] (1, x))\n      (𝓝 (boundaryLimits f hext x n))"
