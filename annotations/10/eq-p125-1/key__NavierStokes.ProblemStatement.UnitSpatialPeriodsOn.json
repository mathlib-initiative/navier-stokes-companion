        "text": "def UnitSpatialPeriodsOn (times : Set ℝ) (g : SpaceTime → V) : Prop := ∀ t ∈ times, ∀ x : Space, ∀ i : Fin 3, g (t, x + coordinateVector i) = g (t, x)"
