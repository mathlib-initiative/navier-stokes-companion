        "line": 69,
        "text": "theorem amplitude_formula (C h τ : ℝ) {r : ℝ} (hr : 0 < r) : amplitude C h τ r = r ^ (-1 - 2 * h) * exteriorProfile C h (τ / r ^ 2)"
