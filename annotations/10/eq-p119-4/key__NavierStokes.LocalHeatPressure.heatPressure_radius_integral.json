          "snippet": {
            "line": 77,
            "text": "theorem heatPressure_radius_integral (C h t z : ℝ) {r : ℝ} (hr : 0 < r) :\n    BaseExterior.heatPressure C h (TerminalStress.radiusPoint t r z) =\n      -(∫ ρ in Ioi r, TerminalStress.heatAmplitude C (1 + h) t ρ ^ 2 / ρ)"
          }
        }
