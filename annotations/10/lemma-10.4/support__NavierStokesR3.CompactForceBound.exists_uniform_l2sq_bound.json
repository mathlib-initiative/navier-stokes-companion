      "snippet": {
        "line": 25,
        "text": "theorem exists_uniform_l2sq_bound {f : VelocityField}\n    (hf : Continuous f) (hcf : HasCompactSupport f) :\n    ∃ C : ℝ, 0 ≤ C ∧ ∀ t ∈ Icc (0 : ℝ) 1,\n      Integrable (fun x : Space => ‖f (t, x)‖ ^ 2) volume ∧\n        (∫ x : Space, ‖f (t, x)‖ ^ 2 ∂volume) ≤ C"
      }
    }
  }
