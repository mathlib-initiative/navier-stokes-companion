          "snippet": {
            "line": 117,
            "text": "theorem divergence_free_periodize {r : ℝ} {u : VelocityField} {times : Set ℝ}\n    (hu : SupportedInCube r u) (hr : r < 1 / 2)\n    (hdiv : ∀ t ∈ times, ∀ x : Space, spatialDivergence u t x = 0) :\n    ∀ t ∈ times, ∀ x : Space, spatialDivergence (periodize u) t x = 0"
          }
        }
      }
