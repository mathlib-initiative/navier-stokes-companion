            "text": "theorem timeDerivative_unique {f g : Plane → ℂ} (hf : ContDiff ℝ ∞ f) (hg : ContDiff ℝ ∞ g)\n    (hpf : SmoothFourierData.UnitPeriodic f) (hpg : SmoothFourierData.UnitPeriodic g)\n    (hD : timeDerivative f = timeDerivative g)\n    (hm : TorusAverages.squareAverage f = TorusAverages.squareAverage g) : f = g"
