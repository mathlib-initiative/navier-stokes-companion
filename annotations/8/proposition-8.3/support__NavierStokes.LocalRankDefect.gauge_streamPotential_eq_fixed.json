      "snippet": {
        "line": 475,
        "text": "theorem gauge_streamPotential_eq_fixed (d a b M : ℝ) (ell : P → ℝ)\n    (v : PressureStream.Plane) (f : Point P → ℝ) (p : Point P) :\n    VariableGaugeMean.streamPotential d a b M ell v f p =\n      PressureStream.streamPotential d (ell p.2.1 * a) (ell p.2.1 * b) M ((0 : P), v) f p"
      }
