          "relation": "states",
          "snippet": {
            "line": 910,
            "text": "theorem tensor_units_identity (P : Patch) (e : ℕ) {q : E → ℝ} (hq : ∀ p, 0 < q p)\n    (A : ℝ) (F : ℝ × E → ℝ) (z : ℝ × E) :\n    q z.2 ^ (2 * A) * physicalSigma P e q F z =\n      sigma P e (normalizedResidual q A F) (z.1 / lengthScale q z.2, z.2)"
          }
        }
