      "snippet": {
        "line": 626,
        "text": "theorem realCentered_finiteJets (m : ℕ) :\n    ∃ K : ℝ, 0 ≤ K ∧ ∀ (f : P × Plane → ℝ) (A : Set P) (C : ℝ),\n      ContDiff ℝ ∞ f → ParameterPeriodic f → 0 ≤ C →\n      (∀ j ≤ m + 4, ∀ p ∈ A, ∀ Y, ‖iteratedFDeriv ℝ j f (p, Y)‖ ≤ C) →\n      ∀ j ≤ m, ∀ p ∈ A, ∀ Y, ‖iteratedFDeriv ℝ j (realCentered f) (p, Y)‖ ≤ K * C"
      }
    }
  }
}
