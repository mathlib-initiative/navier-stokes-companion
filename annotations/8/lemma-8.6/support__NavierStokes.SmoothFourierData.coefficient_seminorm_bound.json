          "snippet": {
            "line": 368,
            "text": "theorem coefficient_seminorm_bound {f : Plane → ℂ} (hf : ContDiff ℝ ∞ f)\n    (hp : UnitPeriodic f) (p : ℕ) {C : ℝ}\n    (hzero : ∀ x ∈ Icc (0 : ℝ) 1, ∀ y ∈ Icc (0 : ℝ) 1, ‖f (x, y)‖ ≤ C)\n    (hfirst : ∀ x ∈ Icc (0 : ℝ) 1, ∀ y ∈ Icc (0 : ℝ) 1,\n      ‖xJet (p + 4) f (x, y)‖ ≤ C)\n    (hsecond : ∀ x ∈ Icc (0 : ℝ) 1, ∀ y ∈ Icc (0 : ℝ) 1,\n      ‖xJet (p + 4) (swapFunction f) (x, y)‖ ≤ C) :\n    coeffSeminorm p (coefficient f) ≤\n      (3 ^ (p + 4) * C) * ∑' k : Frequency, (weight k ^ 4)⁻¹"
          }
        }
      }
    }
  ]
