      "snippet": {
        "line": 847,
        "text": "theorem applyMultiplier_finiteJets (n l : ℕ) :\n    ∃ K : ℝ, 0 ≤ K ∧ ∀ (m : Frequency → ℂ) (B : ℝ), 0 ≤ B →\n      (∀ k, ‖m k‖ ≤ B * weight k ^ l) →\n      ∀ (f : Source P) (S : Set P) (C : ℝ), ContDiff ℝ ∞ f → Periodic f → 0 ≤ C →\n        JetBound f S (n + l + 4) C → JetBound (applyMultiplier m f) S n (K * B * C)"
      }
    }
  }
