      "snippet": {
        "line": 241,
        "text": "def FiveRows (V G : ℝ → ℝ) (d : Debt) (dv ga : ℝ → ℝ) : Prop := (∫ R, R ^ 2 * dv R) = 0 ∧ (∫ R, R * ga R) = 0 ∧ (∫ R, (2 * V R / R) * dv R) = -(d 0) ∧ (∫ R, R ^ 2 * (G R * dv R + V R * ga R)) = -(d 1) ∧ (∫ R, 2 * R * G R * ga R - R * V R * dv R) = -(d 2)"
      }
