          "relation": "supporting",
          "snippet": {
            "line": 688,
            "text": "theorem rankStage_debt_eq (g : VariableGaugeMean.GaugeData P) (r : CorrectionState.RankData P)\n    (axial : P × PressureStream.Plane) (c : CorrectionState.Context (Point P))\n    (u : CorrectionState.State (Point P)) :\n    CorrectionState.debt c (VariableGaugeMean.rankStageState g r axial c u) =\n      defects c.operators c.base (updated u.mean (VariableGaugeMean.rankIncrementState g r axial c u))\n        u.covariance"
          }
