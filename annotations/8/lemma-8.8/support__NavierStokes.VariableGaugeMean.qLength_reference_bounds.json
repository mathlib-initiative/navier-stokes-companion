      "role": "support",
      "snippet": {
        "line": 1473,
        "text": "theorem qLength_reference_bounds {coord a b : ℝ} (U : SlowRegion coord)\n    (ha : 0 < a) (hab : a < b) :\n    ∃ c e L : ℝ, 0 < c ∧ c < e ∧ 0 < L ∧\n      (∀ s ∈ U.carrier, 0 < qLength coord s) ∧\n      (∀ s ∈ U.carrier, c ≤ qLength coord s * a) ∧\n      (∀ s ∈ U.carrier, qLength coord s * b ≤ e) ∧\n      (∀ s ∈ U.carrier, qLength coord s ≤ L)"
      }
    }
  }
