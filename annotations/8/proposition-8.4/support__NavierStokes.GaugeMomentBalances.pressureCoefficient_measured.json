      "snippet": {
        "line": 75,
        "text": "theorem pressureCoefficient_measured (g : VariableGaugeMean.GaugeData S) (n : ℕ) (s : S)\n    (hl : 0 < g.length n s) (Y : Plane) :\n    (IntegratedMeanBalances.moment 2 (fun R => VariableGaugeMean.density\n      g.radial.inner g.radial.outer g.radial.inner_lt_outer (g.length n) (R, (s, Y)))) / 2 =\n      pressureCoefficient g n s"
      }
