          "snippet": {
            "line": 132,
            "text": "theorem pressureMass_eq_interval {a b : ℝ} {f : Lift S → ℝ}\n    (hf : ContDiff ℝ ∞ f) (hs : RadialAlias.RadiallySupported a b f) (s : S) :\n    pressureMass f s = ∫ r in a..b, torusAverage f (r, s)"
