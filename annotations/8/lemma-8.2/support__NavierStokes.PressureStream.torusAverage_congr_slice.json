            "text": "theorem torusAverage_congr_slice {f g : Lift S → ℝ} (p : ℝ × S)\n    (h : ∀ Y : Plane, f (p.1, (p.2, Y)) = g (p.1, (p.2, Y))) :\n    torusAverage f p = torusAverage g p"
