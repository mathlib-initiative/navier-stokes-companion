          "relation": "supporting",
          "snippet": {
            "line": 779,
            "text": "theorem physicalTotal_eq_integral {d a b M : ℝ} (ha : 0 < a) (hab : a < b) (hd : 0 < d)\n    (v : E) {g : ℝ × E → ℝ} (hg : ContDiff ℝ ∞ g) (hs : RadialAlias.RadiallySupported a b g)\n    (p : ℝ × E) (hp : a ≤ p.1) :\n    physicalTotal d a M v g p =\n      ∫ r in a..b, g (r, p.2 + (M * (r ^ d - p.1 ^ d)) • v)"
          }
        }
      }
    }
