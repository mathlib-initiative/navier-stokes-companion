      "snippet": {
        "line": 300,
        "text": "theorem graphDr_divideRadius {f : ℝ × E → ℝ} (k : ℝ → ℝ) (v : E) {p : ℝ × E}\n    (hf : DifferentiableAt ℝ f p) (hr : p.1 ≠ 0) :\n    graphDr k v (divideRadius f) p + divideRadius f p / p.1 = graphDr k v f p / p.1"
      }
