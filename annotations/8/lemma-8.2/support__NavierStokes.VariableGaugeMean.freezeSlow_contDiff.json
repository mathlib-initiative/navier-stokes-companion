        "text": "theorem freezeSlow_contDiff {U : Set S} (hU : IsOpen U) {s : S} (hs : s ∈ U)\n    {f : PressureStream.Lift S → ℝ} (hf : ContDiffOn ℝ ∞ f (PhysicalMeanDomain.slowDomain U)) :\n    ContDiff ℝ ∞ (PhysicalMeanDomain.freezeSlow s f)"
