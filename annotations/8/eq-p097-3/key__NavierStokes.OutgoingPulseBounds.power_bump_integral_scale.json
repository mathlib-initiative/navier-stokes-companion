          "snippet": {
            "line": 543,
            "text": "theorem power_bump_integral_scale (a : ℝ) {k l u : ℝ}\n    (hk : 0 < k) (hl : 0 < l) (hlu : l < u) :\n    (∫ t : ℝ, t ^ a * LocalizedMomentRepair.bump (k * l) (k * u) t) =\n      (k * k ^ a) * ∫ t : ℝ, t ^ a * LocalizedMomentRepair.bump l u t"
          }
        }
      }
