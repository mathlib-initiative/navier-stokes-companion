            "line": 542,
            "text": "theorem weighted_translate_integral (s y0 : ℝ) (f : ℝ → ℝ) :\n    (∫ y, Real.exp (s * y) * f (y - y0)) =\n      Real.exp (s * y0) * ∫ y, Real.exp (s * y) * f y"
