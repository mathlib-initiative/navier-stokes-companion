            "text": "theorem fieldOnPhysical_apply (h : ℝ) (n i : ℕ) (a : ℝ)\n    (f : PressureStream.Lift Plane → ℝ) (z : PressureStream.Lift Plane) :\n    fieldOnPhysical h n i a f z = ChartScales.Q n ^ (-a) * f (physicalToChart h n i z)"
