            "text": "theorem moment_deriv_succ {f : ℝ → ℝ} (hf : ContDiff ℝ ∞ f)\n    (hs : HasCompactSupport f) (n : ℕ) :\n    moment (n + 1) (deriv f) = -((n + 1 : ℕ) : ℝ) * moment n f"
