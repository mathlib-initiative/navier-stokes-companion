          "snippet": {
            "line": 241,
            "text": "def FiveRows (V G : ℝ → ℝ) (d : Debt) (dv ga : ℝ → ℝ) : Prop :=\n  (∫ R, R ^ (2 : ℕ) * dv R) = 0 ∧\n  (∫ R, R * ga R) = 0 ∧\n  (∫ R, (2 * V R / R) * dv R) = -(d 0) ∧\n  (∫ R, R ^ (2 : ℕ) * (G R * dv R + V R * ga R)) = -(d 1) ∧\n  (∫ R, 2 * R * G R * ga R - R * V R * dv R) = -(d 2)"
          }
        }
      }
