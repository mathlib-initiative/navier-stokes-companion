            "line": 66,
            "text": "theorem CandidateProperties.uniform_l2_sq_bound {ν : ℝ}\n    {u : VelocityField} {p : PressureField} {f : VelocityField} {K : Set Space}\n    (h : CandidateProperties ν u p f K) :\n    ∃ C : ℝ, 0 ≤ C ∧ ∀ t ∈ Ico (0 : ℝ) 1,\n      SquareIntegrableAtTime u t ∧ (∫ x : Space, ‖u (t, x)‖ ^ 2) ≤ C"
