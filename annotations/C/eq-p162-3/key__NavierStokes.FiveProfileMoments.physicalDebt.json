          "snippet": {
            "line": 486,
            "text": "noncomputable def physicalDebt (A G : ℝ) (z : Coeff) : Debt :=\n  ![A * z.1 0, Real.sqrt 2 * A * z.2 0,\n    Real.sqrt 2 * A ^ 2 * z.1 1 + G * (Real.sqrt 2 * A * z.2 0),\n    2 * G * A * z.1 0 - A ^ 2 * z.2 1, A ^ 2 * z.2 2]"
          }
        }
