          "snippet": {
            "line": 277,
            "text": "def InTrueCone (p₁ p₂ A C : ℝ) : Prop :=\n  0 < A ∧ 2 < A * (1 + (C / A) ^ 2) ∧ 2 < p₁ + p₂ * (C / A) ∧\n    A * (1 + (C / A) ^ 2) < coneBound (p₁ + p₂ * (C / A)) (p₂ - p₁ * (C / A))"
          }
        }
