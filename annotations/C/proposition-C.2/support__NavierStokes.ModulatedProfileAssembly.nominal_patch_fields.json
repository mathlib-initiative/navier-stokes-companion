      "snippet": {
        "line": 207,
        "text": "theorem nominal_patch_fields {F : OutgoingProfile.Profile} (W : NominalProfile.Witness F)\n    (eta : ℝ) {X : ℝ} (hX : X ∈ Ioo (repairPatch W).left (repairPatch W).right) :\n    W.profiles.U (X, eta) = 0 ∧ W.profiles.E (X, eta) =\n      ReservedPatches.xAmplitude F W.controls.radius eta * X ^ (-1 / 2 - F.data.core.lam)"
      }
    }
  }
}
