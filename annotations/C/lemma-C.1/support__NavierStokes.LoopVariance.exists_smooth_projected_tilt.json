          "relation": "supporting",
          "snippet": {
            "line": 885,
            "text": "theorem exists_smooth_projected_tilt (p₁ p₂ m V : ℝ)\n    (hP : 2 < p₁ + p₂ * m) (hV : 0 ≤ V) :\n    ∃ t : ℝ → ℝ, ContDiff ℝ (∞ : WithTop ℕ∞) t ∧\n      Function.Periodic t (2 * Real.pi) ∧ angularMean t = m ∧\n      angularMean (fun θ => (t θ - m) ^ 2) = V ∧\n      ∀ θ, 2 < p₁ + p₂ * t θ"
          }
        }
      }
    }
