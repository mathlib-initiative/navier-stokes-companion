        "line": 64,
        "text": "theorem shears_smoothAt {D : RadialDomain} (P : Profiles D) {p : Point}\n    (hp : p ∈ D.carrier) (hX : 0 < p.1) (hf : P.f p ≠ 0) :\n    ContDiffAt ℝ ∞ (ActivationContinuation.shearA P) p ∧\n      ContDiffAt ℝ ∞ (ActivationContinuation.shearB P) p"
      }
