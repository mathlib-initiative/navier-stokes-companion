      "snippet": {
        "line": 359,
        "text": "theorem profile_radialDerivative {R : ℝ} (hR : 0 < R) {U : Set ℂ} (hU : IsOpen U)\n    (F : AxisFunction R U) {X eta : ℝ} (hX : X ∈ Ioo (0 : ℝ) (R ^ 2))\n    (heta : (eta : ℂ) ∈ U) :\n    profile (radialDerivative hR hU F) (X, eta) =\n      SimilarityProfile.partialX (profile F) (X, eta)"
      }
