      "snippet": {
        "line": 277,
        "text": "def InTrueCone (p₁ p₂ A C : ℝ) : Prop := 0 < A ∧ 2 < A * (1 + (C/A)^2) ∧ 2 < p₁ + p₂ * (C/A) ∧ A * (1 + (C/A)^2) < coneBound (p₁ + p₂ * (C/A)) (p₂ - p₁ * (C/A))  -- with v = A(1+(C/A)^2) and t = C/A this is 2 < v < 𝒰(P_c(t), J_c(t)) plus 0 < a_L and 2 < P_c(t)"
      }
    }
  }
