          "snippet": {
            "line": 342,
            "text": "theorem linearEquiv_apply (P : Patch) (b : ℝ) (hb : GoodExponent b) (c : Coeff) :\n    linearEquiv P b hb c =\n      (![∫ x, u P c x, ∫ x, x ^ (b + 1 / 2) * u P c x],\n        ![∫ x, x ^ (1 / 2 : ℝ) * e P c x, ∫ x, x ^ b * e P c x, ∫ x, x ^ (b - 1) * e P c x])"
          }
        }
      }
    }
