      "snippet": {
        "line": 446,
        "text": "def mixedWeightSum (ε r n m) := ∑ ij ∈ antidiagonal n, ∑ kl ∈ antidiagonal m, (((m.choose kl.1 : ℝ) * ij.2) / radialDivisor r n) * weight ε ij.1 (kl.1 + 1) * weight ε ij.2 kl.2"
      }
