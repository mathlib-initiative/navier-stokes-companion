          "snippet": {
            "line": 446,
            "text": "def mixedWeightSum (ε : ℝ) (r n m : ℕ) : ℝ :=\n  ∑ ij ∈ antidiagonal n, ∑ kl ∈ antidiagonal m,\n    (((m.choose kl.1 : ℝ) * ij.2) / radialDivisor r n) *\n      weight ε ij.1 (kl.1 + 1) * weight ε ij.2 kl.2"
          }
        }
      }
    }
