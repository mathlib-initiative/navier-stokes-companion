          "snippet": {
            "line": 425,
            "text": "theorem pressure_le_of_ideal_prefix {g a : ℝ → ℝ} {A P : ℝ}\n    (h : Admissible g a A)\n    (hg : ∀ y ≤ 0, g y = P ^ 2 * Real.exp ((1 / 5 : ℝ) * y))\n    (ha : ∀ y ≤ 0, a y = 1) (η : ℝ) :\n    pressure g a η ≤ -(5 / 2 : ℝ) * P ^ 2 * ((1 + η ^ 2)⁻¹) ^ 2"
          }
        }
      }
    }
  ]
