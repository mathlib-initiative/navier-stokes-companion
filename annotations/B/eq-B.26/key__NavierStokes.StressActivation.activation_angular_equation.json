          "snippet": {
            "line": 333,
            "text": "theorem activation_angular_equation (T κ : ℝ) {J : Set ℝ} (hJ : IsOpen J) {L : Field}\n    (hL : ContDiffOn ℝ ∞ L (logDomain J hJ).carrier) (y : ℝ) {η : ℝ} (hη : η ∈ J) :\n    HasDerivAt (fun x => Real.log (activatedAngular T κ L (x, η)))\n      (-(damping T κ y * referenceP1 L (y, η)) / 2) y"
          }
        }
      }
