          "snippet": {
            "line": 212,
            "text": "theorem exists_cutoff_parameters {h j : ℝ} {P : ℝ → ℝ}\n    (p : Parameters h j) (pP : PressureData P) :\n    ∃ δ σ : ℝ, 0 < δ ∧ 0 < σ ∧\n      (∀ η ∈ Icc (-1 : ℝ) 1, |Z h j P η| ≤ δ → 99 / 100 < chi h j σ η) ∧\n      ContDiff ℝ ∞ (chi h j σ)"
          }
        }
      }
