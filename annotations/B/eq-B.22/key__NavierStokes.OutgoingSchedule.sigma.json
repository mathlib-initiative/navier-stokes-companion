      "snippet": {
        "line": 26,
        "text": "def sigma (x : ℝ) := FlatCutoff.edge 1 x / (FlatCutoff.edge 1 x + FlatCutoff.edge 1 (1 - x)), with edge c x = if x ≤ 0 then 0 else exp (-c / x ^ 2) — literally the σ of (A.5); it is NOT the step wired into slopeCutoff"
      }
