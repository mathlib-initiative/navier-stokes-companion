          "snippet": {
            "line": 199,
            "text": "theorem exists_duration (B : ℝ) (hB : 0 ≤ B) :\n    ∃ T : ℝ, 0 < T ∧ ∀ (li : ℝ → ℝ) (C y eta : ℝ),\n      |logShape eta - li eta| ≤ B →\n      11 / 20 ≤ 1 / 2 + deriv (fun s => logProfile C T li (s, eta)) y ∧\n      1 / 2 + deriv (fun s => logProfile C T li (s, eta)) y ≤ 13 / 20"
          }
        }
      }
    }
