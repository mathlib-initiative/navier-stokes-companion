            "line": 668,
            "text": "theorem same_radius_log_slope {δ : ℝ} (hδ : 0 < δ) (hδT : 2 * δ < rampLimit)\n    {p : Point} (hη : p.2 ∈ parameterInterval) (hX : 0 < p.1) (ht : N.logTime p.1 < rampLimit) :\n    p.1 * deriv (fun X => Real.log (N.refF δ (X, p.2))) p.1 =\n      slopeCutoff δ (N.logTime p.1) * (p.1 * radialPartial N.f p / N.f p)"
          }
        }
      }
