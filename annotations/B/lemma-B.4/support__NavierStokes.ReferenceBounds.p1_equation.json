      "snippet": {
        "line": 261,
        "text": "theorem p1_equation {p : Point} (hp : p ∈ D.carrier) (hX : 0 < p.1)\n    (hf : P.f p ≠ 0) (h : ℝ) :\n    p.1 * deriv (fun x => p1 P h (x, p.2)) p.1 + logSlope P p * p1 P h p =\n      p.1 * sourceQ P h p / NaturalAxisData.L h p.2"
      }
    }
  }
