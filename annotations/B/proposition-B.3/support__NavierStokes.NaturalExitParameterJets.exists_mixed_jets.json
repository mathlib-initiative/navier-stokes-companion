          },
          "relation": "supporting",
          "snippet": {
            "line": 60,
            "text": "theorem exists_mixed_jets (k N : ℕ) : ∃ B, 1 ≤ B ∧\n    ∀ Λ C, ∀ E : CoefficientProfile d Λ C, ∀ Y ∈ Icc (0 : ℝ) (41 / 10),\n      ∀ n ≤ N, ∀ η ∈ parameterInterval,\n        |iteratedDeriv n (fun ξ => AxisEvaluation.mixedSeries window d.coefficients.epsilon\n          E.coefficients.1 k 0 (Y, ξ)) η| ≤ B ∧\n        |iteratedDeriv n (fun ξ => AxisEvaluation.mixedSeries window d.coefficients.epsilon\n          E.coefficients.2 k 0 (Y, ξ)) η| ≤ B"
          }
        }
      }
    }
  ]
