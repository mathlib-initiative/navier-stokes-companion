          "relation": "states",
          "snippet": {
            "line": 96,
            "text": "theorem pressure_increment_bound {p : Point} (_ : p ∈ D.carrier) (hX : 0 ≤ p.1)\n    {K C : ℝ} (_ : 0 ≤ K) (_ : 0 < C)\n    (hf : ∀ s ∈ Icc (0 : ℝ) p.1, |P.f (s, p.2)| ≤ K / C) :\n    |P.pressure p - P.pressure0 p.2| ≤ p.1 * K ^ 2 / C ^ 2"
          }
