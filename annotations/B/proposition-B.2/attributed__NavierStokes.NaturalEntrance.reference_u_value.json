          "snippet": {
            "line": 650,
            "text": "theorem reference_u_value {h j σ : ℝ} {P0 : ℝ → ℝ}\n    (v : CoefficientFamily h j σ P0) (Y : ℝ) {η : ℝ} (hη : η ∈ window.interval) :\n    AxisEvaluation.profile window v.epsilon (referencePair v).2 (Y, η) =\n      -(Y * NaturalAxisData.Z h j P0 η / (2 * NaturalAxisData.L h η))"
          }
        }
