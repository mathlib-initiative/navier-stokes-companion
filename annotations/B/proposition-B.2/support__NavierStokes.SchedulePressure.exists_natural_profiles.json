          "relation": "supporting",
          "snippet": {
            "line": 267,
            "text": "theorem exists_natural_profiles (d : TailData) {j : ℝ}\n    (hsmall : NaturalAxisData.SmallParameters d.h j) (hP : 2 ≤ d.core.P) :\n    ∃ δ σ Λ C : ℝ, 0 < δ ∧ 0 < σ ∧ 0 < Λ ∧ 0 < C ∧\n      ∃ f U V Pr : ℝ × ℝ → ℝ,\n        NaturalProfile.IsNaturalSolution d.h j Λ (axisPressure d)\n          (NaturalAxisCoefficients.realAmplitude d.h j σ Λ C) f U V Pr ∧\n        (∀ p ∈ NaturalProfile.domain Λ, 0 ≤ Λ * p.1 → Λ * p.1 ≤ 41 / 10 → 0 < f p) ∧\n        (∀ η ∈ Icc (-1 : ℝ) 1,\n          |NaturalAxisData.Z d.h j (axisPressure d) η| ≤ δ →\n            23 / 10 < -2 * (4 / Λ) * NaturalAxisBridge.partialY f (4 / Λ, η) / f (4 / Λ, η))"
          }
        }
      }
    }
  ]
