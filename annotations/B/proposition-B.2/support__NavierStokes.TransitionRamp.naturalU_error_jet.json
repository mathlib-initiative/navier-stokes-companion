        "line": 2033,
        "text": "theorem naturalU_error_jet {C : ℝ} (E : NaturalEntrance.CoefficientProfile d Λ C)\n    {X η : ℝ} (hY : Λ * X ∈ Ioo (-20 : ℝ) 20) (hη : η ∈ parameterInterval) (n : ℕ) :\n    iteratedDeriv n (fun ξ => E.family.U (X, ξ) - NaturalAxisData.U j ξ) η =\n      (1 / Λ) * AxisEvaluation.mixedSeries window d.coefficients.epsilon E.coefficients.2 0 n (Λ * X, η)"
      }
