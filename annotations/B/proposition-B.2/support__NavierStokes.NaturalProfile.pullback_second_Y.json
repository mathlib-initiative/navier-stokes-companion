      "snippet": {
        "line": 91,
        "text": "theorem pullback_second_Y {F : ℝ × ℝ → ℝ}\n    (hF : ContDiffOn ℝ ∞ F (AxisEvaluation.strip window 20))\n    (Λ : ℝ) {p : ℝ × ℝ} (hp : p ∈ domain Λ) :\n    iteratedDeriv 2 (fun X : ℝ => pullback Λ F (X, p.2)) p.1 =\n      Λ ^ 2 * iteratedDeriv 2 (fun Y : ℝ => F (Y, p.2)) (Λ * p.1)"
      }
    }
