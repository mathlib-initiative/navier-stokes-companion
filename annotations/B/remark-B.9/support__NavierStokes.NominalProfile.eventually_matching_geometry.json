        "line": 159,
        "text": "theorem eventually_matching_geometry (F : Profile) (T radiusFloor normFloor : ℝ) :\n    ∀ᶠ C : ℝ in atTop, 0 < C ∧ normFloor ≤ C ∧ radiusFloor < matchingRadius F C ∧\n      ShapeTransition.separation T C F.data.core.P < Real.exp (-8)"
      }
