          "snippet": {
            "line": 245,
            "text": "theorem norm_le_iff_derivative_bound (I : Window) (w : ℕ → ℕ → ℝ)\n    (hw : ∀ n m, 0 < w n m) (A : CoefficientSpace I w) (C : ℝ) (hC : 0 ≤ C) :\n    ‖A‖ ≤ C ↔ ∀ (n m : ℕ) (x : I.interval),\n      |iteratedDerivWithin m (coefficient I w A n) I.interval x| / w n m ≤ C"
          }
        }
      }
    }
