            "line": 224,
            "text": "theorem normalized_derivative (I : Window) (w : ℕ → ℕ → ℝ)\n    (hw : ∀ n m, w n m ≠ 0) (A : CoefficientSpace I w)\n    (n m : ℕ) (x : I.interval) :\n    iteratedDerivWithin m (coefficient I w A n) I.interval x / w n m =\n      A.1 ((n, m), x)"
          }
        }
