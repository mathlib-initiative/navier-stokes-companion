        "text": "def weight (ε : ℝ) (n m : ℕ) : ℝ := (1 / 20 : ℝ) ^ n * (ε⁻¹) ^ m * (m.factorial : ℝ) * ((n + m).choose m : ℝ) / (((n : ℝ) + 1) ^ 2 * ((m : ℝ) + 1) ^ 2)"
