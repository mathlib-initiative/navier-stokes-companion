      "snippet": {
        "line": 235,
        "text": "theorem recoveredSource_mixed (I : Window) {ε : ℝ} (hε : 0 < ε) (r : ℕ) (hr : 1 ≤ r)\n    (F G : AxisSpace I ε) (n : ℕ) {x : ℝ} (hx : x ∈ I.interval) :\n    recoveredSource I ε r (inverseMixed I hε r hr F G) n x =\n      ∑ ij ∈ antidiagonal n, inputJet I ε F ij.1 1 x *\n        ((ij.2 : ℝ) * coefficient I (weight ε) G ij.2 x)"
      }
    }
  }
