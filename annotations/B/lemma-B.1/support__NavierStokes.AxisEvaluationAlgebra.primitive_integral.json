      "snippet": {
        "line": 454,
        "text": "theorem primitive_integral (I : Window) {ε : ℝ} (hε : 0 < ε)\n    (A : AxisSpace I ε) {Y η : ℝ} (hY : Y ∈ Ioo (-20 : ℝ) 20)\n    (hη : η ∈ Ioo I.left I.right) :\n    profile I ε (primitive I hε A) (Y, η) =\n      ∫ y in (0 : ℝ)..Y, profile I ε A (y, η)"
      }
