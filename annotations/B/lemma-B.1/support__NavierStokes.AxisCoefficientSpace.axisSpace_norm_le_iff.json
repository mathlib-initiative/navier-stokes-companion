      "snippet": {
        "line": 450,
        "text": "theorem axisSpace_norm_le_iff (I : Window) {ε : ℝ} (hε : 0 < ε)\n    (A : AxisSpace I ε) (C : ℝ) (hC : 0 ≤ C) :\n    ‖A‖ ≤ C ↔ ∀ (n m : ℕ) (x : I.interval),\n      |iteratedDerivWithin m (coefficient I (AxisWeightEstimates.weight ε) A n) I.interval x| /\n        AxisWeightEstimates.weight ε n m ≤ C"
      }
    }
  }
