      "snippet": {
        "line": 193,
        "text": "theorem recoveredSource_insert (I : Window) {ε : ℝ} (hε : 0 < ε) (r : ℕ) (hr : 1 ≤ r)\n    (A B : AxisSpace I ε) (n : ℕ) {x : ℝ} (hx : x ∈ I.interval) :\n    recoveredSource I ε r (insert I hε r hr A B) n x =\n      ∑ ij ∈ antidiagonal n, recoveredSource I ε r A ij.1 x *\n        coefficient I (weight ε) B ij.2 x"
      }
    }
  }
