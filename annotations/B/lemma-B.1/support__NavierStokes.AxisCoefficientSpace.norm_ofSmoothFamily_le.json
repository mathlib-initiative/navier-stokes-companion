      "snippet": {
        "line": 419,
        "text": "theorem norm_ofSmoothFamily_le (I : Window) (w : ℕ → ℕ → ℝ) (hw : ∀ n m, 0 < w n m)\n    (F : ℕ → ℝ → ℝ) (hF : ∀ n, ContDiffOn ℝ ∞ (F n) I.interval)\n    (C : ℝ) (hC : 0 ≤ C)\n    (hbound : ∀ n m x, x ∈ I.interval →\n      |iteratedDerivWithin m (F n) I.interval x| ≤ C * w n m) :\n    ‖ofSmoothFamily I w hw F hF C hC hbound‖ ≤ C"
      }
