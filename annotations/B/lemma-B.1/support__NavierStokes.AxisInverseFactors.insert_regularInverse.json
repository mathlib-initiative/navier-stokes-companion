      "snippet": {
        "line": 132,
        "text": "theorem insert_regularInverse (I : Window) {ε : ℝ} (hε : 0 < ε) (r : ℕ) (hr : 1 ≤ r)\n    (F B : AxisSpace I ε) :\n    insert I hε r hr (regularInverse I hε r hr F) B =\n      regularInverse I hε r hr (product I hε F B)"
      }
    }
  }
