      "snippet": {
        "line": 263,
        "text": "theorem coefficient_ext (I : Window) (w : ℕ → ℕ → ℝ)\n    (hw : ∀ n m, w n m ≠ 0) (A B : CoefficientSpace I w)\n    (h : ∀ n x, x ∈ I.interval → coefficient I w A n x = coefficient I w B n x) :\n    A = B"
      }
