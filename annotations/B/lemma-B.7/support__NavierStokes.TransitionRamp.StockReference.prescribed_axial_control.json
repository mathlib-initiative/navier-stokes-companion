      "role": "support",
      "snippet": {
        "line": 307,
        "text": "theorem prescribed_axial_control (hJ : IsOpen J) (T κ w₁ y : ℝ)\n    {η : ℝ} (hη : η ∈ J) :\n    deriv (fun x => R.axialVelocity T κ w₁ (x, η)) y =\n      -(1 - step R.bigTime w₁ y) * damping T κ y * R.axialStock (y, η) / 2"
      }
    }
  }
