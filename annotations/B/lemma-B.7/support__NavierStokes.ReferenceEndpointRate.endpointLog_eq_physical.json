      "snippet": {
        "line": 299,
        "text": "theorem endpointLog_eq_physical {J' : Set ℝ} (R : StockReference J')\n    (hR : R.radius0 < 110) (T κ w₁ w₂ : ℝ) {C : ℝ} (hC : 0 < C) (η : ℝ) :\n    R.endpointLog T κ w₁ w₂ C η =\n      Real.log (C*(Real.sqrt 220*R.physicalF T κ w₁ w₂ (110,η)))"
      }
    }
  }
