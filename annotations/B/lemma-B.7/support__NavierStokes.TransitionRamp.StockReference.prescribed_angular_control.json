          "relation": "supporting",
          "snippet": {
            "line": 298,
            "text": "theorem prescribed_angular_control (hJ : IsOpen J) (T κ w₁ w₂ y : ℝ)\n    {η : ℝ} (hη : η ∈ J) :\n    -2 * deriv (fun x => R.logAmplitude T κ w₁ w₂ (x, η)) y =\n      (1 - step (R.bigTime + w₁) w₂ y) * damping T κ y * R.angularStock (y, η) +\n        (4 / 5 : ℝ) * step (R.bigTime + w₁) w₂ y"
          }
        }
      }
    }
  ]
