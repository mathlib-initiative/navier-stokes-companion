          "relation": "states",
          "snippet": {
            "line": 540,
            "text": "theorem physicalMoments_eq (P : Patch) (lam R a : ℝ) (hR : 0 < R) (c : Coeff) :\n    physicalMoments P lam R a c =\n      ![2 * a ^ 2 * momentMap P lam c 0,\n        2 * R * a ^ 2 * momentMap P lam c 1,\n        R * Real.sqrt (2 * R) * a * momentMap P lam c 2]"
          }
        }
      }
