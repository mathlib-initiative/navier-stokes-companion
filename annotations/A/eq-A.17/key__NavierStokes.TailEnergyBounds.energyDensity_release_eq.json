          "relation": "states",
          "snippet": {
            "line": 140,
            "text": "theorem energyDensity_release_eq (d : TailData) (eta : ℝ) {y : ℝ}\n    (hy : d.releaseStart ≤ y) :\n    energyDensity d eta y = energyDensity d eta d.releaseStart *\n      Real.exp (2 * releasePrimitive d (y - d.releaseStart)) *\n      (tailShape d (y - tailStart d) / (1 - d.rho)) ^ 2"
          }
        }
      }
    }
