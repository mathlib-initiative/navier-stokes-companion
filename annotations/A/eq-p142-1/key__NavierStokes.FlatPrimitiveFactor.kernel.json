      "snippet": {
        "line": 30,
        "text": "def kernel (c : ℝ) (j : ℕ) (b : ℝ → ℝ) (x t : ℝ) : ℝ := (1/2) * Real.exp (-c * t) * (denominator x t ^ j / denominator x t ^ 3) * b (coordinate x t)  -- the unparameterized slice"
      }
    }
