      "snippet": {
        "line": 53,
        "text": "def kernel (c : ℝ) (j : ℕ) (b : E × ℝ → ℝ) (y : E × ℝ) (t : ℝ) : ℝ := (1/2) * Real.exp (-c * t) * (FlatPrimitiveFactor.denominator y.2 t ^ j / FlatPrimitiveFactor.denominator y.2 t ^ 3) * b (y.1, FlatPrimitiveFactor.coordinate y.2 t)"
