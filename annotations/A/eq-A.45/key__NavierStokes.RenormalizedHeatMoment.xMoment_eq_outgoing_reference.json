          },
          "snippet": {
            "line": 715,
            "text": "theorem xMoment_eq_outgoing_reference (P : OutgoingProfile.Profile) {XR : ℝ} (hXR : 0 < XR)\n    (E : ℝ × ℝ → ℝ) (eta : ℝ) :\n    xMoment P.data.h (outgoingPowerAmplitude P XR) E eta =\n      ∫ X in Ioi (0 : ℝ), Real.sqrt (2 * X) * E (X, eta) - OutgoingDilation.powerH P XR X"
          }
        }
      }
