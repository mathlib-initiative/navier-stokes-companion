          "snippet": {
            "line": 557,
            "text": "def finalAngular (d : TailData) (p : ℝ × ℝ) : ℝ :=\n  flattened d p * Real.exp (releaseAdjustment d (p.1 - d.releaseStart)) *\n    (tailShape d (p.1 - tailStart d) / (1 - d.rho))"
