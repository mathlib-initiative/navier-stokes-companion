          "relation": "definition",
          "snippet": {
            "line": 219,
            "text": "noncomputable def forwardTheta (F : Profile) (XR : ℝ) (c : ℝ → Coeff)\n    (p : ℝ × ℝ) : ℝ :=\n  HeatSwitchCone.logE F XR c p / Real.sqrt (2 * XR * Real.exp p.1) *\n    (XR * Real.exp p.1 * HeatSwitchCone.Qs F XR c p /\n      CoordinateAlgebra.L F.data.h p.2 - HeatSwitchCone.radialA F XR c p)"
          }
        }
      }
