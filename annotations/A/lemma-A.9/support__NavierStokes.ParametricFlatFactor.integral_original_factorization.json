      "snippet": {
        "line": 99,
        "text": "theorem integral_original_factorization (c : ℝ) (j : ℕ) (b : E × ℝ → ℝ)\n    (p : E) {x : ℝ} (hx : 0 < x) :\n    (∫ u in (0 : ℝ)..x, (Real.exp (-c / u ^ 2) / u ^ j) * b (p, u)) =\n      Real.exp (-c / x ^ 2) * x ^ (3 - (j : ℝ)) * factor c j b (p, x)"
      }
    }
  }
