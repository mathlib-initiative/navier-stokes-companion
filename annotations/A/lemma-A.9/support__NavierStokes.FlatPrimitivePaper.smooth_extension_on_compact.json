        "line": 20,
        "text": "theorem smooth_extension_on_compact {K U : Set E} (hK : IsCompact K)\n    (hU : IsOpen U) (hKU : K ⊆ U) {b : E → ℝ}\n    (hb : ContDiffOn ℝ ∞ b U) :\n    ∃ b' : E → ℝ, ContDiff ℝ ∞ b' ∧ EqOn b' b K"
      }
