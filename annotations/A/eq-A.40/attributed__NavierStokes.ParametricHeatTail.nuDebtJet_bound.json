          "relation": "implies",
          "snippet": {
            "line": 562,
            "text": "theorem nuDebtJet_bound (d : TailData) {K : ℝ} (hK : 1 ≤ K) (square : Bool)\n    {q : ℝ} (hq : tailDecay d square + q < 0) (n : ℕ) {ν : ℝ}\n    (hν : ν ∈ Icc (0 : ℝ) 1) :\n    |nuDebtJet d K square q n ν| ≤ nuConstant d square q n * K ^ q"
          }
        }
