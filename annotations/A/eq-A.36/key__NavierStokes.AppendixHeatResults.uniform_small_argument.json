            "line": 166,
            "text": "theorem uniform_small_argument {h h₀ z : ℝ} (hh : 0 < h) (hh₀ : h ≤ h₀)\n    (hz : 0 ≤ z) :\n    |profile (1 + h) z - 1| + |z * derivWithin (profile (1 + h)) (Ici 0) z| ≤\n      (2 * (1 + h₀)) * h * z"
