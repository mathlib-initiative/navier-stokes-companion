      "snippet": {
        "line": 689,
        "text": "theorem profile_eq_integral (a z : ℝ) :\n    profile a z = (Real.Gamma a)⁻¹ *\n      ∫ v in Ioi (0 : ℝ), Real.exp (-v) * v ^ (a - 1) * (1 + z * v) ^ (1 - a)"
      }
    }
  }
