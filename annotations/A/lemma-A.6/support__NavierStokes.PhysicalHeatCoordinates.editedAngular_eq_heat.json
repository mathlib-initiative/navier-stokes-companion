          "snippet": {
            "line": 54,
            "text": "theorem editedAngular_eq_heat (d : OutgoingTail.TailData) {K : ℝ}\n    (hK : 0 < K) (hh1 : d.h < 1 / 2) {p : PhysicalPoint}\n    (ht : p.1 < 1) (hs : 0 < p.2.1)\n    (hfull : 1 / 2 ≤ Real.log (X d.h p / K) + 1 / 5) :\n    editedAngular d K p =\n      TerminalStress.physicalHeat (normalization d K) (1 + d.h) p *\n        TerminalStress.flattening d.h (shape d K) p"
          }
        }
      }
