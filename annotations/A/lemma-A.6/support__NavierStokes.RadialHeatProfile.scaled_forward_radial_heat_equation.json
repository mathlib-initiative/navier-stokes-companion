      "snippet": {
        "line": 714,
        "text": "theorem scaled_forward_radial_heat_equation (C : ℝ) {a t r : ℝ}\n    (ha : 1 < a) (ht : t < 1) (hr : 0 < r) :\n    deriv (fun t => C * radialProfile a (1 - t) r) t =\n      iteratedDeriv 2 (fun r => C * radialProfile a (1 - t) r) r +\n        deriv (fun r => C * radialProfile a (1 - t) r) r / r -\n        C * radialProfile a (1 - t) r / r ^ 2"
      }
    }
  }
