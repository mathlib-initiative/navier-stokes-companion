          "snippet": {
            "line": 145,
            "text": "theorem momentCandidate_hasDerivAt (d : TailData) (q : ℝ → ℝ) {y : ℝ}\n    (hy : d.releaseStart ≤ y)\n    (hq : HasDerivAt q (-profileSlope d y - d.h - (1 + profileSlope d y) * q y) y) :\n    HasDerivAt (momentCandidate d q) (releaseWeight d y) y"
