          "snippet": {
            "line": 713,
            "text": "theorem tail_integrating_factor (d : TailData) (t : ℝ) :\n    Real.exp (primitive (tailRate d) t) =\n      Real.exp ((1 - d.h) * t) * tailShape d t / (1 - d.rho)"
