          "relation": "states",
          "snippet": {
            "line": 1134,
            "text": "theorem correctionJet_bound (c : Parameters) (hsmall : c.lam ≤ 1 / 120)\n    (amp : ℝ → ℝ) (k : ℕ) {eta : ℝ} (heta : |eta| ≤ 1) (y : ℝ) :\n    |correctionJet c amp k eta y| ≤\n      (2 * correctionJetBound c.P c.m k) * Real.exp (-(1 / (4 * c.lam))) * (1 + |amp eta|)"
          }
        }
