          "relation": "states",
          "snippet": {
            "line": 1160,
            "text": "theorem correctionJet_eta_bound (c : Parameters) (hsmall : c.lam ≤ 1 / 120)\n    {amp : ℝ → ℝ} {eta amp' : ℝ} (ha : HasDerivAt amp amp' eta)\n    (heta : |eta| ≤ 1) (k : ℕ) (y : ℝ) :\n    |deriv (fun t => correctionJet c amp k t y) eta| ≤\n      (4 * correctionJetBound c.P c.m k) * Real.exp (-(1 / (4 * c.lam))) * (1 + |amp'|)"
          }
        }
      }
