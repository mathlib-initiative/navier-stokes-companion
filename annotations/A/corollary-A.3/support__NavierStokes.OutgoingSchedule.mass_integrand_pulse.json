          "relation": "supporting",
          "snippet": {
            "line": 695,
            "text": "theorem mass_integrand_pulse (c : Parameters) (amp : ℝ → ℝ) (eta : ℝ) {y : ℝ}\n    (hy : c.pulseStart ≤ y) :\n    Real.exp y * axial c amp (y, eta) =\n      (momentScale c 0 * shape eta) *\n        (Real.exp ((c.exponents 0 + 1) * (y - c.pulseStart)) *\n          radialPulse c amp eta (Real.exp (y - c.pulseStart)))"
          }
        }
      }
