          "relation": "implies",
          "snippet": {
            "line": 188,
            "text": "theorem radialAmplitude_hold {dropLength lam a y P : ℝ} (hd : 0 ≤ dropLength)\n    (ha : dropLength + 2 ≤ a) (hay : a ≤ y) :\n    radialAmplitude P dropLength lam y =\n      radialAmplitude P dropLength lam a * Real.exp (-(1 / 2 + lam) * (y - a))"
          }
        }
      }
