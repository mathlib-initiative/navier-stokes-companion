          "snippet": {
            "line": 641,
            "text": "theorem Qs_after_endpoint (w : ResetWitness d K) {Amp : ℝ → ℝ}\n    (ha : ContDiff ℝ ∞ Amp) (eta : ℝ) {y : ℝ} (hy : d.core.endpoint ≤ y) :\n    Qs w Amp (y, eta) = -1 +\n      ((1 - d.h) * I w (y, eta) - axialExponent d.h * eta * dEta (I w) (y, eta)) /\n        (Real.exp (3 * y / 2) * E w (y, eta))"
          }
        }
      }
