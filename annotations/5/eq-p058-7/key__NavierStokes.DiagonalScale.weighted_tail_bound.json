      "role": "key",
      "snippet": {
        "line": 209,
        "text": "theorem weighted_tail_bound (g : ℕ → ℝ) (hg : Monotone g) (L q : ℝ) (hq : 0 < q) (hq1 : q ≤ 1) (J : ℕ) : Summable (fun n => (1/2)^(J+1+n) * q ^ (g (J+1+n)/2 - L)) ∧ (∑' n, (1/2)^(J+1+n) * q ^ (g (J+1+n)/2 - L)) ≤ (1/2)^J * q ^ (g (J+1)/2 - L)"
      }
    }
  }
