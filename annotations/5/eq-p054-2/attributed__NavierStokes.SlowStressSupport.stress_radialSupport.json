            "text": "theorem stress_radialSupport (m : ℕ) {F : Field} {S : Set ℝ} {a B : ℝ} (hB : 0 ≤ B)\n    (hinner : ∀ eta ∈ S, ∀ R ∈ Icc 0 a, F (R, eta) = 0)\n    (hs : exterior B S F) (hm : ∀ eta ∈ S, moment B 0 F eta = 0) :\n    radialSupport S a B (stress m F)"
