          "snippet": {
            "line": 239,
            "text": "theorem profileStress_jets (C : ℝ) (d : TailData) (y0 : ℝ) (n : ℕ)\n    {b : ℝ} (hb : 0 < b) :\n    ∃ M : ℝ, 0 < M ∧ ∃ N : ℕ, ∀ i ≤ n, ∀ η ∈ Icc (-1 : ℝ) 1,\n      ∀ x : ℝ, 0 < x → x ≤ b →\n        ‖iteratedFDeriv ℝ i (profileStress C d y0) (η, x)‖ ≤\n          M * FlatCutoff.edge 4 x / x ^ N"
          }
        }
