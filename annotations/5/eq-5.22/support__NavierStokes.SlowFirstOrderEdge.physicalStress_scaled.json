          "relation": "uses",
          "snippet": {
            "line": 646,
            "text": "theorem physicalStress_scaled (C : ℝ) (d : TailData) (y0 : ℝ)\n    {t r z : ℝ} (ht : t < 1) (hr : 0 < r) :\n    physicalStress C d y0 t z r =\n      physicalScale d t z ^ (-CoordinateAlgebra.A d.h - 1 / 2 + 2 * d.h) *\n        stressX C d y0 ((r ^ 2 / 2) / physicalScale d t z, physicalEta d t z)"
          }
