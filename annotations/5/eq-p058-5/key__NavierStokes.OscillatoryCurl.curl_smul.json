          "snippet": {
            "line": 101,
            "text": "theorem curl_smul {f : Space → ℝ} {B : Space → Space} {x : Space}\n    (hf : DifferentiableAt ℝ f x) (hB : DifferentiableAt ℝ B x) :\n    SpatialCurl.curl (fun y => f y • B y) x =\n      cross (gradientLinear (fderiv ℝ f x)) (B x) + f x • SpatialCurl.curl B x"
          }
        }
      }
