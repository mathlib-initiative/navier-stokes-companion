          "relation": "uses",
          "snippet": {
            "line": 124,
            "text": "theorem velocity_zero (H K : Profile) (t : ℝ) (x : Space)\n    (hH : DifferentiableAt ℝ H (profilePoint t x))\n    (hK : DifferentiableAt ℝ K (profilePoint t x)) :\n    velocity H K (t, x) 0 =\n      -x 0 * partialZ H (profilePoint t x) / 2 + x 1 * partialS K (profilePoint t x)"
          }
