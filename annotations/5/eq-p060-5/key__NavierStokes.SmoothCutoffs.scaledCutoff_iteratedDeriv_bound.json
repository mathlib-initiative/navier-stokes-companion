          "snippet": {
            "line": 230,
            "text": "theorem scaledCutoff_iteratedDeriv_bound (n : ℕ) :\n    ∃ C : ℝ, 0 ≤ C ∧ ∀ a q : ℝ, 0 ≤ a → 0 < q →\n      |iteratedDeriv (n + 1) (scaledCutoff a) q| ≤ C * (1 / q) ^ (n + 1)"
          }
        }
      }
