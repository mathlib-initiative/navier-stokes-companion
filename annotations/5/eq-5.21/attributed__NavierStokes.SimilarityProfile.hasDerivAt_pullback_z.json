          "snippet": {
            "line": 180,
            "text": "theorem hasDerivAt_pullback_z {h b : ℝ} {f : InnerProfile}\n    (hh : 0 < h) (hh1 : h < 1 / 2) {p : PhysicalPoint} (hp : p.1 < 1)\n    (hf : DifferentiableAt ℝ f (inner h p)) :\n    HasDerivAt (fun z => pullback h b f (p.1, (p.2.1, z)))\n      (pullback h (b - D h) (Z h b f) p) p.2.2"
          }
        }
