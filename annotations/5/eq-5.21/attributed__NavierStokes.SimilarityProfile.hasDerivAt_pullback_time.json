          "snippet": {
            "line": 160,
            "text": "theorem hasDerivAt_pullback_time {h b : ℝ} {f : InnerProfile}\n    (hh : 0 < h) (hh1 : h < 1 / 2) {p : PhysicalPoint} (hp : p.1 < 1)\n    (hf : DifferentiableAt ℝ f (inner h p)) :\n    HasDerivAt (fun t => pullback h b f (t, p.2))\n      (pullback h (b - 1) (T h b f) p) p.1"
          }
        }
