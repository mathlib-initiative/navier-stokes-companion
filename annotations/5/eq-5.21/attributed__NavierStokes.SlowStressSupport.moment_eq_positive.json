          "relation": "implies",
          "snippet": {
            "line": 115,
            "text": "theorem moment_eq_positive {S : Set ℝ} {f : Field} {B : ℝ} (hB : 0 ≤ B)\n    (hs : exterior B S f) {eta : ℝ} (heta : eta ∈ S) (m : ℕ) :\n    moment B m f eta = PositiveOrderMoments.positiveIntegral (fun R => R ^ m * f (R, eta))"
          }
        }
      }
