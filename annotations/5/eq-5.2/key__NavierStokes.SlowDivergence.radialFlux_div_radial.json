          "relation": "states",
          "snippet": {
            "line": 29,
            "text": "theorem radialFlux_div_radial (h lam : ℝ) (U : Field) {p : Point} (hX : p.1 ≠ 0) :\n    radialFlux h lam U p / p.1 = (CoordinateAlgebra.L h p.2)⁻¹ *\n      (2 * p.2 * U p - 2 * p.2 * (CoordinateAlgebra.D h + lam) * average U p -\n        CoordinateAlgebra.d p.2 * SimilarityProfile.partialEta (average U) p)"
          }
        }
