          "snippet": {
            "line": 676,
            "text": "theorem solutionSeries_equation {z : ℂ} (hz : z ∈ Metric.ball center ρ) :\n    solutionSeries hR A₀ A₁ F z = F z + pathInverse hR VolterraAnalyticBounds.exponent\n      (coefficientAction (A₀ z) (solutionSeries hR A₀ A₁ F z) +\n        coefficientAction (A₁ z) (deriv (solutionSeries hR A₀ A₁ F) z))"
          }
