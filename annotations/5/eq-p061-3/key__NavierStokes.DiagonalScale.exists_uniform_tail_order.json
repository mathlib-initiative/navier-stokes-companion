          "snippet": {
            "line": 241,
            "text": "theorem exists_uniform_tail_order (g : ℕ → ℝ) (hg : Monotone g)\n    (hgtop : Tendsto g atTop atTop) (L N : ℝ) (m : ℕ) :\n    ∃ J : ℕ, m ≤ J ∧ ∀ q : ℝ, 0 < q → q ≤ 1 →\n      (∑' n : ℕ, (1 / 2 : ℝ) ^ (J + 1 + n) * q ^ (g (J + 1 + n) / 2 - L)) ≤\n        (1 / 2 : ℝ) ^ J * q ^ N"
          }
        }
      }
