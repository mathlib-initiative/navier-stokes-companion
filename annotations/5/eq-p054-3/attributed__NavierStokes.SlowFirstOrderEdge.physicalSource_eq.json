          "snippet": {
            "line": 526,
            "text": "theorem physicalSource_eq (C : ℝ) (d : TailData) (y0 : ℝ) {p : PhysicalPoint}\n    :\n    physicalSource C d y0 p =\n      -physicalHeat C (1 + d.h) p *\n        deriv (deriv (fun z => physicalTaper d y0 (p.1, (p.2.1, z)))) p.2.2"
          }
        }
      }
