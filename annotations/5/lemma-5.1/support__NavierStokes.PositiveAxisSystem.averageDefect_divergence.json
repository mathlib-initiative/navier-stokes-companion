      "snippet": {
        "line": 682,
        "text": "theorem averageDefect_divergence (Ω : ProfileHistories.RadialDomain) {u : InnerProfile}\n    (hu : ContDiffOn ℝ ∞ u Ω.carrier) (h lam : ℝ) {w : InnerPoint}\n    (hw : w ∈ Ω.carrier) (hL : ell h w.2 ≠ 0) :\n    partialX (SlowDivergence.radialFlux h lam u) w =\n      -axialValue h (-a h + lam) w.2 w.1 (actualJet u w)"
      }
    }
