      "snippet": {
        "line": 692,
        "text": "theorem averageDefect_unique (Ω : ProfileHistories.RadialDomain) {u k : InnerProfile}\n    (hu : ContDiffOn ℝ ∞ u Ω.carrier) (hk : ContDiffOn ℝ ∞ k Ω.carrier)\n    (hrow : ∀ w ∈ Ω.carrier, w.1 * (partialX u w + partialX k w) + k w = 0)\n    {w : InnerPoint} (hw : w ∈ Ω.carrier) : k w = averageDefect u w"
      }
    }
  }
