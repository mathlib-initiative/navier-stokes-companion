      "snippet": {
        "line": 30,
        "text": "positiveStage u0 A B J = fun w => u0 w + MixedDiagonalResidual.uncutVelocity (positiveStages A) (positiveStages B) J w, i.e. u0 + curl ∑_{j≤J} A_j + ∑_{j≤J} B_j — the velocity part of U^{[J]}"
      }
