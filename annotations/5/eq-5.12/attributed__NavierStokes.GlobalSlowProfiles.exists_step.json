            "line": 799,
            "text": "theorem exists_step {S : Set ℝ} {h C : ℝ} (s : Scheme S h C) {n : ℕ} (hn : 0 < n)\n    (previous : (j : ℕ) → j < n → Admissible s j) :\n    ∃ out : Admissible s n, StepProperties s n previous out"
          }
