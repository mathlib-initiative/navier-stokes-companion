      "snippet": {
        "line": 1066,
        "text": "theorem profiles_pressure_eq {S : Set ℝ} {h C : ℝ} (s : Scheme S h C) {n : ℕ} (hn : 0 < n) :\n    (profiles s n).pressure = pressureFromSource s.domain.isOpen\n      (pressureSource C (fun j => (profiles s j).phi)\n        (previousOmegaDivX s.domain (fun j => (profiles s j).axial)\n          (fun j => (profiles s j).beta) n) n)"
      }
    }
  }
