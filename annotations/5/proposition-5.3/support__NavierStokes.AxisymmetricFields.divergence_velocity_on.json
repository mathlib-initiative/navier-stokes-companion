      "snippet": {
        "line": 208,
        "text": "theorem divergence_velocity_on {H K : Profile} {times : Set ℝ}\n    (hH : ContDiffOn ℝ 2 H (times ×ˢ (univ : Set (ℝ × ℝ))))\n    (hK : ContDiffOn ℝ 2 K (times ×ˢ (univ : Set (ℝ × ℝ))))\n    {t : ℝ} (ht : t ∈ times) (x : Space) : spatialDivergence (velocity H K) t x = 0"
      }
