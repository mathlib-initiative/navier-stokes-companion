          "snippet": {
            "line": 68,
            "text": "theorem exists_integer_scale {ι : Type*} (s : Finset ι) (C p : ι → ℝ)\n    (r ε : ℝ) (hr : 0 < r) (hε : 0 < ε) :\n    ∃ a : ℕ, 0 < a ∧\n      ∀ i ∈ s, ∀ q : ℝ, 0 < q → q ≤ 1 / (a : ℝ) →\n        |logPowerWeight (C i) (p i) r q| ≤ ε"
          }
        }
      }
