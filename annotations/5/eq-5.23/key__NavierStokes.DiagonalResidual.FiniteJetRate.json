        "text": "def FiniteJetRate (l : Filter D) (q : D → ℝ) (f : D → V) (M : ℕ) (r : ℝ) : Prop := ∃ C, 0 ≤ C ∧ ∀ᶠ x in l, ∀ m ≤ M, ‖iteratedFDeriv ℝ m f x‖ ≤ C * (q x) ^ r"
