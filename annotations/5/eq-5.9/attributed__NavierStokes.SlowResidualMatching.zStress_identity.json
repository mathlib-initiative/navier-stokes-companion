          "relation": "implies",
          "snippet": {
            "line": 470,
            "text": "theorem zStress_identity {S : Set ℝ} (hS : IsOpen S) (h : ℝ)\n    (f : SlowProfiles) (n : ℕ) (hF : SlowStressSupport.Smooth S (zDensity h f n))\n    {w : InnerPoint} (hX : 0 < w.1) (heta : w.2 ∈ S) :\n    Real.sqrt (2 * w.1) * partialX (zStress h f n) w +\n      zStress h f n w / Real.sqrt (2 * w.1) = -axialCoefficient h f n w"
          }
        }
      }
    }
  ]
