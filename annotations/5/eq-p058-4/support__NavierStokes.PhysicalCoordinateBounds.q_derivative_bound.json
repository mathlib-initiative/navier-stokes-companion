            "line": 410,
            "text": "theorem q_derivative_bound {a : ℝ} (ha : 0 < a) (ha1 : a < 1)\n    (lo hi qbig : ℝ) (n : ℕ) :\n    ∃ C : ℝ, 0 < C ∧ ∀ p ∈ positiveTime, qCoord a p ≤ qbig → xCoord a p ∈ Icc lo hi →\n      ‖iteratedFDeriv ℝ n (qCoord a) p‖ ≤ C * qCoord a p ^ (1 - (n : ℝ))"
          }
        }
