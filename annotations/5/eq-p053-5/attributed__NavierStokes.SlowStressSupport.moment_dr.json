          "snippet": {
            "line": 152,
            "text": "theorem moment_dr {S : Set ℝ} (hS : IsOpen S) {f : Field} (hf : Smooth S f)\n    (B : ℝ) (m : ℕ) {eta : ℝ} (heta : eta ∈ S) :\n    moment B (m + 1) (dr f) eta = B ^ (m + 1) * f (B, eta) -\n      ((m + 1 : ℕ) : ℝ) * moment B m f eta"
          }
        }
