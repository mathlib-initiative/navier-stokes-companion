            "line": 446,
            "text": "theorem phiCorrection_angular_nonneg {S : Set ℝ} (hS : IsOpen S) {a b : ℝ} (ha : 0 < a)\n    {f : Field} (hf : Smooth S f) (hs : PatchSupport a b f) {C : ℝ} (hC : C ≠ 0)\n    {R eta : ℝ} (hR : 0 ≤ R) :\n    angularField C (phiCorrection hS ha hf hs C) (R, eta) = f (R, eta)"
          }
