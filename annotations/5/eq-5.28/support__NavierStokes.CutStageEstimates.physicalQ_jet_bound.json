          "relation": "uses",
          "snippet": {
            "line": 532,
            "text": "theorem physicalQ_jet_bound {h : ℝ} (hh : 0 < h) (hh1 : h < 1 / 2) (m : ℕ) :\n    ∃ C : ℝ, 0 < C ∧ ∀ w ∈ PhysicalWaveSum.preterminal,\n      PhysicalWaveSum.physicalQ h w ≤ 1 →\n      ‖iteratedFDeriv ℝ m (PhysicalWaveSum.physicalQ h) w‖ ≤\n        C * PhysicalWaveSum.physicalQ h w ^ (1 - (m : ℝ))"
          }
        }
