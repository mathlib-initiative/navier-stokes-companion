            "text": "theorem axialDensity_moment_zero {S : Set ℝ} {h C : ℝ} (s : Scheme S h C)\n    {n : ℕ} (hn : 2 ≤ n) {eta : ℝ} (heta : eta ∈ S) :\n    SlowStressSupport.moment s.B 0\n      (SlowStressSupport.axialDensity h n (fluxHistory s) (axialHistory s) (pressureField s n)) eta = 0"
