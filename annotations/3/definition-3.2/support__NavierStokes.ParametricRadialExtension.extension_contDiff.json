        "line": 202,
        "text": "theorem extension_contDiff {S : Set ℝ} (w : ParameterWindow S) {F : Plane → E}\n    (hF : ContDiffOn ℝ ∞ F (univ ×ˢ S))\n    (he : ∀ eta ∈ S, ∀ r, F (-r, eta) = F (r, eta)) :\n    ContDiff ℝ ∞ (extension w F hF he)"
      }
