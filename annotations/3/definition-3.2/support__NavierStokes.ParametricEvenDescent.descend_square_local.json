            "line": 360,
            "text": "theorem descend_square_local {U : Set ℝ} {R : ℝ} {F : Plane → E}\n    (he : ∀ p ∈ U, ∀ r ∈ Ioo (-R) R, F (p, -r) = F (p, r))\n    {p r : ℝ} (hp : p ∈ U) (hr : r ∈ Ioo (-R) R) :\n    descend F (p, r ^ 2) = F (p, r)"
          }
