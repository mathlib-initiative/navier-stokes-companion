            "text": "theorem energy_hasDerivAt {I : Set ℝ} {χ : Space → ℝ} {w : VelocityField}\n    (hI : IsOpen I) (hχ : ContDiff ℝ ∞ χ) (hc : HasCompactSupport χ)\n    (hw : ContDiffOn ℝ ∞ w (I ×ˢ (univ : Set Space))) {t : ℝ} (ht : t ∈ I) :\n    HasDerivAt (fun s => localizedEnergy χ (fun x => w (s, x))) (energyRate χ w t) t"
