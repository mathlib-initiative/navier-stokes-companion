          "relation": "defines",
          "snippet": {
            "line": 180,
            "text": "def AngularGrowth (u : VelocityField) : Prop :=\n  ∃ e₀ C δ : ℝ, 0 < e₀ ∧ 0 < C ∧ 0 < δ ∧ δ ≤ 1 ∧\n    ∀ τ : ℝ, 0 < τ → τ < δ →\n      |τ ^ CoordinateAlgebra.A ActualPrimary.h *\n        u (1 - τ, BaseAngularGrowth.ray innerRadius τ) 1 - e₀| ≤\n          C * τ ^ (2 * ActualPrimary.h)"
          }
        }
      }
