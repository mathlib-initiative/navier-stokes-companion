            "text": "theorem forwardMap_hasFDerivAt {a : ℝ} {p : ℝ × ℝ} (hp : p.1 ≠ 0)\n    (hm : scalarSlope a p.2 p.1 ≠ 0) :\n    HasFDerivAt (forwardMap a)\n      (triangularEquiv (scalarSlope a p.2 p.1) (-2 * p.2 * p.1 ^ a) hm :\n        (ℝ × ℝ) →L[ℝ] (ℝ × ℝ)) p"
