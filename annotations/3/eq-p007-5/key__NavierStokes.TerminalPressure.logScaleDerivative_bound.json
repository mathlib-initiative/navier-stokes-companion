            "text": "theorem logScaleDerivative_bound {h : ℝ} {p : SimilarityProfile.PhysicalPoint}\n    (hh : 0 < h) (hh1 : h < 1 / 2) (ht : p.1 < 1) :\n    |logScaleDerivative h p| ≤ 2 / (1 - 2 * h) * SimilarityProfile.q h p ^ (-CoordinateAlgebra.D h)"
