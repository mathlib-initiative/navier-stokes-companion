            "line": 131,
            "text": "theorem real_vectorMode {X : Type*} (κ : ℝ) (Φ : X → ℝ) (a : X → Vector)\n    (x : X) (i : Fin 3) :\n    (vectorMode κ Φ (fun z j => (a z j : ℂ)) x i).re =\n      a x i * Real.cos (κ * Φ x)"
