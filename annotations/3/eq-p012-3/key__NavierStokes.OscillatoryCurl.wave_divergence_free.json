          "snippet": {
            "line": 188,
            "text": "theorem wave_divergence_free {U : Set SpaceTime} {Φ : PressureField} {a : VelocityField}\n    (k : ℝ) (hU : IsOpen U) (hΦ : ContDiffOn ℝ ∞ Φ U) (ha : ContDiffOn ℝ ∞ a U)\n    (hn : ∀ z ∈ U, phaseNormal Φ z ≠ 0) {z : SpaceTime} (hz : z ∈ U) :\n    spatialDivergence (wave k Φ a) z.1 z.2 = 0"
          }
