          "relation": "states",
          "snippet": {
            "line": 829,
            "text": "theorem pressureCoefficient_eq_zero_iff (h C : ℝ) (f : SlowProfiles)\n    (n : ℕ) (w : InnerPoint) :\n    pressureCoefficient h C f n w = 0 ↔\n      partialX (f.pressure n) w =\n        C⁻¹ ^ 2 * convolution (fun i j => f.phi i w * f.phi j w) n -\n          previous (fun j => omegaCoefficient h f j w) n / (2 * w.1)"
          }
        }
      }
