          "snippet": {
            "line": 82,
            "text": "theorem amplitude_heat_equation (C : ℝ) {h τ r : ℝ}\n    (hh : 0 < h) (hτ : 0 < τ) (hr : 0 < r) :\n    -deriv (fun τ => amplitude C h τ r) τ =\n      iteratedDeriv 2 (amplitude C h τ) r + deriv (amplitude C h τ) r / r -\n        amplitude C h τ r / r ^ 2"
          }
        }
      }
