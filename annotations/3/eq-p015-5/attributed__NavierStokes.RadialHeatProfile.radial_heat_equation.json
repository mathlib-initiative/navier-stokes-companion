          "relation": "implies",
          "snippet": {
            "line": 624,
            "text": "theorem radial_heat_equation {a τ r : ℝ} (ha : 1 < a) (hτ : 0 < τ) (hr : 0 < r) :\n    -deriv (fun τ => radialProfile a τ r) τ =\n      iteratedDeriv 2 (radialProfile a τ) r + deriv (radialProfile a τ) r / r -\n        radialProfile a τ r / r ^ 2"
          }
        }
