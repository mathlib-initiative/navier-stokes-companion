        "text": "noncomputable def torusAverage (f : Lift S → ℝ) (p : ℝ × S) : ℝ := ∫ y in (0:ℝ)..1, torusInner f (p, y)  -- torusInner f (p,y) = ∫ x in (0:ℝ)..1, f (p.1, (p.2, (x, y)))"
