      "snippet": {
        "line": 259,
        "text": "def radialDivergence (k : ℝ) (S : PhysicalProfile) (p : PhysicalPoint) : ℝ := Real.sqrt (2 * p.2.1) * SimilarityProfile.partialS S p + k * S p / Real.sqrt (2 * p.2.1)"
      }
