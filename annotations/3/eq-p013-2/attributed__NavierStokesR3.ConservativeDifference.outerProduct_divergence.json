          "relation": "implies",
          "snippet": {
            "line": 104,
            "text": "theorem outerProduct_divergence {u : VelocityField} {t : ℝ}\n    (hu : ContDiff ℝ ∞ (fun x : Space => u (t, x))) (x : Space) (k : Fin 3) :\n    (∑ i : Fin 3, spatialPartial i (fun y => u (t, y) k * u (t, y) i) x) =\n      u (t, x) k * spatialDivergence u t x + advection u t x k"
          }
        }
      }
