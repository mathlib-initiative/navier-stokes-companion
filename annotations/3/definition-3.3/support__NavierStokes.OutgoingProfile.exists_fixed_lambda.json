      "snippet": {
        "line": 656,
        "text": "theorem exists_fixed_lambda (P m : ℝ) (hP : 0 < P) (hm : 0 < m) :\n    ∃ lam C : ℝ, 0 < lam ∧ 0 < C ∧ ∀ h : ℝ, 0 < h → 2 * h < lam →\n      ∃ F : Profile, F.data.core.P = P ∧ F.data.core.m = m ∧\n        F.data.core.lam = lam ∧ F.data.h = h ∧ Specification F C"
      }
    }
  }
