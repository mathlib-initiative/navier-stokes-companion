            "line": 397,
            "text": "theorem localizedVelocity_eq_curl {A : VelocityField} {times : Set ℝ}\n    (hA : ContDiffOn ℝ ∞ A (times ×ˢ (univ : Set Space)))\n    {t : ℝ} (ht : t ∈ times) (x : Space) :\n    localizedVelocity A (t, x) = SpatialCurl.spatialCurl (localizedPotential A) (t, x)"
          }
