          "relation": "states",
          "snippet": {
            "line": 200,
            "text": "theorem cutVelocity_product_rule (A : VelocityField) (t : ℝ) (x : Space)\n    (hA : DifferentiableAt ℝ (fun y => A (t, y)) x) :\n    cutVelocity A (t, x) = spatialCutoff x • SpatialCurl.spatialCurl A (t, x) +\n      SpatialCurl.curlLinear ((fderiv ℝ spatialCutoff x).smulRight (A (t, x)))"
          }
        }
      }
    }
  ]
