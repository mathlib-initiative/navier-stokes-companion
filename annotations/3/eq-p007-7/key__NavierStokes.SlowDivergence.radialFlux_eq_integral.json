          "snippet": {
            "line": 136,
            "text": "theorem radialFlux_eq_integral (Ω : RadialDomain) {U : Field}\n    (hU : ContDiffOn ℝ ∞ U Ω.carrier) (h lam : ℝ) {p : Point} (hp : p ∈ Ω.carrier) :\n    radialFlux h lam U p =\n      ∫ x in (0 : ℝ)..p.1, -SimilarityProfile.Z h (-CoordinateAlgebra.A h + lam) U (x, p.2)"
          }
        }
      }
