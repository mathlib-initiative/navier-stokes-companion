          "snippet": {
            "line": 226,
            "text": "theorem Expr.polynomialBound_of_jetBound (e : Expr) {b : ℝ → ℝ} {R : ℝ}\n    (hR : 0 ≤ R)\n    (hjets : ∀ k ≤ e.jetOrder, ∃ C : ℝ, 0 ≤ C ∧\n      ∀ y : ℝ, |y| ≤ R → |iteratedDeriv k b y| ≤ C) :\n    PolynomialBound R (e.eval b)"
