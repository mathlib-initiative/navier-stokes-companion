          "snippet": {
            "line": 136,
            "text": "theorem uncutVelocity_eq_stagePrefix {U : Set SpaceTime} (hU : IsOpen U)\n    (A B : ℕ → VelocityField) (hA : ∀ j, ContDiffOn ℝ ∞ (A j) U) (J : ℕ) :\n    EqOn (MixedDiagonalResidual.uncutVelocity A B J)\n      (DiagonalJetBounds.uncutPrefix (stageVelocity A B) (J + 1)) U"
          }
