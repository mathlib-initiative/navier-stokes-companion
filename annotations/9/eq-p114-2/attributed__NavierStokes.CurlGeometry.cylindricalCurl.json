          "snippet": {
            "line": 145,
            "text": "def cylindricalCurl {F : Type*} [CommRing F]\n    (Dr Dθ Dz : F →+ F) (q : F) (A : Vec3 F) : Vec3 F :=\n  ![q * Dθ (A 2) - Dz (A 1),\n    Dz (A 0) - Dr (A 2),\n    Dr (A 1) + q * A 1 - q * Dθ (A 0)]"
          }
        }
      }
