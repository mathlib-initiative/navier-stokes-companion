            "line": 69,
            "text": "theorem polynomialEdge_jets_bound {c : ℝ} (hc : 0 < c) (p : ℝ[X]) (n : ℕ)\n    {d : ℝ} (hd : 0 < d) :\n    ∃ C : ℝ, 0 < C ∧ ∃ N : ℕ, ∀ i ≤ n, ∀ x : ℝ, 0 < x → x ≤ d →\n      ‖iteratedFDeriv ℝ i (FlatCutoff.polynomialEdge c p) x‖ ≤\n        C * FlatCutoff.edge c x / x ^ N"
          }
        }
      }
    }
