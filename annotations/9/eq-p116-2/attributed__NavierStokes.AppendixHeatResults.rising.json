      "snippet": {
        "line": 16,
        "text": "def rising (b : ℝ) (n : ℕ) : ℝ := ∏ k ∈ Finset.range n, (b + k); docstring: \"The rising factorial used in the manuscript.\" — so rising h m = (h)_m and rising (1+h) m = (1+h)_m"
      }
