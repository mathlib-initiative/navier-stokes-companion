          "relation": "supporting",
          "snippet": {
            "line": 562,
            "text": "theorem iterate_divergence_zero {ι : Type} {coord : ℝ}\n    (U : LocalSignedRequest.SlowRegion coord) (p : ℕ → CycleParameters ι)\n    (c : Context Point) (seed : CycleState ι) (V : Set Point)\n    (hV : ∀ j, (p j).strip.domain = V)\n    (H₀ : LiftedMeanResidual.MeanHypotheses V c seed.state)\n    (H : ∀ j, StepData U (p j) (CycleState.iterate p c seed j).coefficients c\n      (CycleState.iterate p c seed j).state)\n    (j n : ℕ) {x : Point × ℝ} (hx : x ∈ LiftedMeanResidual.cylinder V) :\n    fullDivergence c (CycleState.iterate p c seed j).state n x = 0"
          }
        }
      }
    }
  ]
