          "relation": "supporting",
          "snippet": {
            "line": 1027,
            "text": "theorem excluded_nativeBounds {N : ℕ} {U : Set Cylinder} {gain : ℝ} {loss : ℕ → ℝ}\n    (hN : 1 ≤ N) (hU : IsOpen U) (e : CorrectionState.ExcludedErrors Point)\n    (hb : NativeBounds N U gain loss (fun (_ : Unit) => e.base))\n    (hg : NativeBounds N U gain loss (fun (_ : Unit) => e.gaussian))\n    (ha : NativeBounds N U gain loss (fun (_ : Unit) => e.aliasError)) :\n    NativeBounds N U gain loss (fun (_ : Unit) => e.total)"
          }
