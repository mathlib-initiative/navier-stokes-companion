        "text": "vectorPotential (K : ℝ) (R : D → ℝ) (Vr Vθ Vz : D → D) (Φ : D → ℝ) (a : D → ComplexVector) := HarmonicCalculus.vectorMode K Φ (fun x => inverseCarrier K • coefficient R Vr Vθ Vz Φ a x)"
