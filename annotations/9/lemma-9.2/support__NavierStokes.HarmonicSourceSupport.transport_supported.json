          "relation": "supporting",
          "snippet": {
            "line": 151,
            "text": "theorem transport_supported {K : Set D} (hK : IsClosed K)\n    (g : HarmonicResidual.Frame D) (k : ℝ) (Φ : D → ℝ) (kp : ℤ)\n    {a b : HarmonicResidual.VectorCoefficients D}\n    (ha : ∀ i, NonzeroSupported K (a i)) (hb : ∀ i, NonzeroSupported K (b i)) :\n    ∀ i, NonzeroSupported K (HarmonicResidual.transport g k Φ kp a b i)"
          }
