            "line": 427,
            "text": "theorem weights_jets {R : I → ℕ → D → Vec2} {w : ℕ → D → ℝ} {β : ℝ}\n    (hw : ∀ n x, x ∈ s.domain → 0 ≤ w n x)\n    (hR : ∀ a, LocalJets s w β K (fun n i x => R i n x a)) (j : Fin 2) :\n    LocalJets s w β K (fun n i x => SmoothCovariance.weights (H i n x) (R i n x) j)"
          }
