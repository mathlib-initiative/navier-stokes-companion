          "snippet": {
            "line": 101,
            "text": "noncomputable def totalVelocity (s : State D) (c : Context D) : Oscillation D :=\n  fun n p => ![c.base.radial n p.1 + s.mean.radial n p.1 + s.oscillation n p 0,\n    c.base.angular n p.1 + s.mean.angular n p.1 + s.oscillation n p 1,\n    c.base.axial n p.1 + s.mean.axial n p.1 + s.oscillation n p 2]"
          }
