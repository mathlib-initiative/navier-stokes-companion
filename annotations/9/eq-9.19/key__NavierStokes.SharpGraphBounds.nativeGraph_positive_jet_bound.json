          "snippet": {
            "line": 52,
            "text": "theorem nativeGraph_positive_jet_bound {h a b : ℝ} (hh : 0 ≤ h) (ha : 0 < a)\n    (m : ℕ) : ∃ C : ℝ, 1 ≤ C ∧ ∀ n : ℕ, 4 ≤ n → ∀ p : SpaceTime,\n      scaledRadial n p ∈ annulus a b → |p.1| ≤ 1 → ∀ k, 1 ≤ k → k ≤ m →\n      ‖iteratedFDeriv ℝ k (nativeGraph h n) p‖ ≤\n        C * ChartScales.Q n ^ (-(k : ℝ) * (1 + h))"
          }
        }
      }
