          "snippet": {
            "line": 76,
            "text": "noncomputable def pressureSource (a b : ℝ) (hab : a < b) (ell : S → ℝ)\n    (f : PressureStream.Lift S → ℝ) (z : PressureStream.Lift S) : ℝ :=\n  f z - density a b hab ell z * PressureStream.pressureMass f z.2.1"
