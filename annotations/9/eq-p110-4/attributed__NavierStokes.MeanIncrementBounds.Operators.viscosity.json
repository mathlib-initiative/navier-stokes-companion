          "relation": "defines",
          "snippet": {
            "line": 69,
            "text": "noncomputable def viscosity (o : Operators D) (c : ℝ) (f : Field D) : Field D :=\n  fun n x => o.epsilon n *\n    (o.dr (o.dr f) n x + o.invRadius n x * o.dr f n x +\n      o.dz (o.dz f) n x - c * (o.invRadius n x * (o.invRadius n x * f n x)))"
          }
