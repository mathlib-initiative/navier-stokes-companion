            "text": "theorem logE_parameter_deriv {p : Point} (hp : p ∈ D.carrier)\n    (hX : 0 < p.1) (hf : P.f p ≠ 0) :\n    deriv (fun η => Real.log (P.E (p.1, η))) p.2 = parameterPartial P.H p / P.H p"
