      "snippet": {
        "line": 37,
        "text": "theorem admissible_iff {a b p₁ p₂ : ℝ} (ha : 0 < a) (hv : 2 < shearMagnitude a b) : AdmissibleCone a b p₁ p₂ ↔ shearMagnitude a b < parallelStress a b p₁ p₂ ∧ (shearMagnitude a b - 2) * transverseStress a b p₁ p₂ ^ 2 < 2 * (parallelStress a b p₁ p₂ - shearMagnitude a b) ^ 2"
      }
