        "line": 65,
        "text": "theorem stress_inner_normal (F τ p₁ p₂ a c : ℝ) (ha : a ≠ 0) : ⟪τ • !₂[p₁ - a, p₂ - c], normalDirection (F • !₂[-a, -c])⟫_ℝ = -(τ * F * a / ‖F • !₂[-a, -c]‖) * (p₁ + p₂ * (c / a) - a * (1 + (c / a) ^ 2))"
      }
