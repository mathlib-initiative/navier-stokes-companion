      "snippet": {
        "line": 60,
        "text": "theorem uniform_boundary_collar {K B N : Set E} (hB : IsCompact B)\n    (hN : IsOpen N) (hBN : B ⊆ N) {a m : E → ℝ} {A C : E × ℝ → ℝ}\n    (hmatch : ∀ x ∈ K ∩ N, ∀ φ, A (x, φ) = a x ∧ C (x, φ) = a x * m x) :\n    ∃ δ : ℝ, 0 < δ ∧ ∀ x ∈ K, ∀ y ∈ B, dist x y < δ →\n      ∀ φ, A (x, φ) = a x ∧ C (x, φ) = a x * m x"
      }
    }
  }
}
