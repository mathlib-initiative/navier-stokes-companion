          "relation": "definition",
          "snippet": {
            "line": 283,
            "text": "def HasConeMargin (ε p₁ p₂ A C : ℝ) : Prop :=\n  ε ≤ A ∧ ε ≤ A * (1 + (C / A) ^ 2) - 2 ∧ ε ≤ p₁ + p₂ * (C / A) - 2 ∧\n    ε ≤ coneBound (p₁ + p₂ * (C / A)) (p₂ - p₁ * (C / A)) - A * (1 + (C / A) ^ 2)"
          }
