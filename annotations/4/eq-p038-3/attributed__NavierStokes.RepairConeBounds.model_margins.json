            "line": 755,
            "text": "theorem model_margins (F : Profile) (hh : F.data.h ≤ 1 / 100) :\n    ∃ delta : ℝ, 0 < delta ∧ ∀ v : Control, ‖v‖ ≤ delta → ∀ p ∈ window,\n      3 / 5 ≤ familyA F (v, p) ∧ familySpeed F (v, p) ≤ 1 ∧\n        Real.exp (-8) / 2 ≤ familyProjection F (v, p)"
