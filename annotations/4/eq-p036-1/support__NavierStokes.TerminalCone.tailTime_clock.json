          "relation": "uses",
          "snippet": {
            "line": 477,
            "text": "theorem tailTime_clock (F : OutgoingProfile.Profile) {XR : ℝ} (hXR : 0 < XR) (y : ℝ) :\n    Real.log ((XR * Real.exp y) / OutgoingDilation.switchRadius F XR) + 1 / 5 =\n      y - OutgoingTail.tailStart F.data"
          }
        }
      }
