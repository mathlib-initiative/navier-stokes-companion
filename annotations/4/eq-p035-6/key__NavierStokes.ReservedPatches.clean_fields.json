          "relation": "states",
          "snippet": {
            "line": 309,
            "text": "theorem clean_fields (F : Profile) (XR : ℝ) (hXR : 0 < XR) (s : Slot)\n    (eta : ℝ) {X : ℝ} (hX : X ∈ window F XR s) :\n    OutgoingDilation.U F XR (X, eta) = 0 ∧\n      OutgoingDilation.E F XR (X, eta) =\n        xAmplitude F XR eta * X ^ (-(1 / 2 + F.data.core.lam))"
          }
        }
      }
