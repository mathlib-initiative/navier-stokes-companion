          "relation": "supporting",
          "snippet": {
            "line": 1126,
            "text": "theorem exists_modulated_profile :\n    ∃ (F : OutgoingProfile.Profile) (W : NominalProfile.Witness F)\n      (d : LoopData W) (v : Witness d), ∀ p : Point,\n      NominalConeAssembly.activeLeft W < p.1 → p.1 < NominalConeAssembly.activeRight W →\n      p.2 ∈ Icc (-1 : ℝ) 1 →\n      TrueConeLoop.InTrueCone\n        (ActivationStocks.profileStockOne v.profiles F.data.h p)\n        (ActivationStocks.profileStockTwo v.profiles F.data.h p)\n        (ModulatedCone.angularShear v.profiles.E p)\n        (ModulatedCone.signedAxialShear v.profiles.E v.profiles.U p)"
          }
        }
      }
    }
  ]
