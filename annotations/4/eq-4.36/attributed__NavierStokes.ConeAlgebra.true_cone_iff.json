            "line": 69,
            "text": "theorem true_cone_iff {P J v : ℝ} (hv : 2 < v) :\n    (2 < P ∧ v < coneBound P J) ↔\n      (v < P ∧ (v - 2) * J ^ 2 < 2 * (P - v) ^ 2)"
