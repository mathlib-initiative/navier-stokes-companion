      "snippet": {
        "line": 247,
        "text": "structure EdgeFactor (K : Set E) (c : ℝ) (T : E × ℝ → V) where coefficient; order; width; smooth : ContDiffOn ℝ ∞ coefficient domain; boundary_ne_zero : ∀ p ∈ K, coefficient (p,0) ≠ 0; identity : ∀ p ∈ K, ∀ x, 0 < x → x < width → T (p,x) = (FlatCutoff.edge c x / x ^ order) • coefficient (p,x)"
      }
