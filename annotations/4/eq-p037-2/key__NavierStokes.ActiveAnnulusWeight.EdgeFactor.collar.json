          "snippet": {
            "line": 310,
            "text": "theorem EdgeFactor.collar {K : Set E} (hK : IsCompact K) {c : ℝ} {T : E × ℝ → V}\n    (F : EdgeFactor K c T) :\n    ∃ d m : ℝ, 0 < d ∧ d < F.width ∧ d ≤ 1 ∧ 0 < m ∧\n      K ×ˢ Icc (0 : ℝ) d ⊆ F.domain ∧\n      ∀ p ∈ K, ∀ x : ℝ, 0 < x → x ≤ d → m * FlatCutoff.edge c x ≤ ‖T (p,x)‖"
          }
        }
      }
    }
