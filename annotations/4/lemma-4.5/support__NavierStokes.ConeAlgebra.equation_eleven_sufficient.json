          "relation": "supporting",
          "snippet": {
            "line": 153,
            "text": "theorem equation_eleven_sufficient {a b w : ℝ} (ha : 0 < a)\n    (hfirst : 0 < a - b * w)\n    (hsecond : 2 * b * w + b ^ 2 / a + (a - 2) * w ^ 2 < 2) :\n    ∃ p₀ : ℝ, ∀ p : ℝ, p₀ < p →\n      2 < p * (1 - b * w / a) ∧ a * (1 + (b / a) ^ 2) <\n        coneBound (p * (1 - b * w / a)) (p * (w + b / a))"
          }
        }
      }
