          "snippet": {
            "line": 1068,
            "text": "theorem Qs_eq_source_integral (w : ResetWitness d K) {Amp : ℝ → ℝ}\n    (ha : ContDiff ℝ ∞ Amp) (y eta : ℝ) :\n    Qs w Amp (y, eta) =\n      (∫ t in Iic y, Real.exp (3 * t / 2) * E w (t, eta) * Sq w Amp (t, eta)) /\n        (Real.exp (3 * y / 2) * E w (y, eta))"
          }
