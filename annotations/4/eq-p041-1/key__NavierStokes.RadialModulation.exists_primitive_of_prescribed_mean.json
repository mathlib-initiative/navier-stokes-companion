          "snippet": {
            "line": 257,
            "text": "theorem exists_primitive_of_prescribed_mean\n    (f : ℝ → ℝ) (hf : ContDiff ℝ ∞ f) (hperiodic : Function.Periodic f 1)\n    (m c : ℝ) (hmean : intervalIntegral f 0 1 volume = m) :\n    ∃ A : ℝ → ℝ, ContDiff ℝ ∞ A ∧ Function.Periodic A 1 ∧\n      intervalIntegral A 0 1 volume = 0 ∧ ∀ θ, HasDerivAt A (c * (f θ - m)) θ"
          }
        }
      }
