          "snippet": {
            "line": 271,
            "text": "theorem extendedPrimitive_hasDerivAt\n    {K U : Set P} (χ : CompactCutoff K U)\n    (f : P × ℝ → ℝ) (m c : P → ℝ)\n    (hf : ∀ p ∈ U, Continuous (fun θ => f (p, θ)))\n    (p : P) (hp : p ∈ K) (θ : ℝ) :\n    HasDerivAt (fun s => extendedPrimitive χ f m c (p, s))\n      (c p * (f (p, θ) - m p)) θ"
          }
        }
      }
    }
  ]
