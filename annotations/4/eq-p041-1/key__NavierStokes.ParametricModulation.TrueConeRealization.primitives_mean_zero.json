            "text": "theorem primitives_mean_zero (r : TrueConeRealization a m p₁ p₂ K B)\n    (E : P → ℝ) (ha : ContDiff ℝ ∞ a) (hm : ContDiff ℝ ∞ m)\n    (hp₂ : ContDiff ℝ ∞ p₂) (p : P) :\n    intervalIntegral (fun θ => r.angularPrimitive (p, θ)) 0 1 volume = 0 ∧\n      intervalIntegral (fun θ => r.axialPrimitive E (p, θ)) 0 1 volume = 0"
