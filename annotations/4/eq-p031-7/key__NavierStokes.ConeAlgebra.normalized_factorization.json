          "snippet": {
            "line": 101,
            "text": "theorem normalized_factorization (a b w : ℝ) (ha : a ≠ 0) :\n    (a * (1 + (b / a) ^ 2) - 2) * (w + b / a) ^ 2 -\n        2 * (1 - b * w / a) ^ 2 =\n      (1 + (b / a) ^ 2) * ((a - 2) * w ^ 2 + 2 * b * w + b ^ 2 / a - 2)"
          }
        }
      }
    }
