          "snippet": {
            "line": 412,
            "text": "theorem Qs_integrated (w : ResetWitness d K) (Amp : ℝ → ℝ) (p : Point) :\n    Qs w Amp p = -W d Amp p +\n      ((1 - d.h) * I w p - axialExponent d.h * p.2 * dEta (I w) p -\n        coordinateFactor p.2 * dEta (J w Amp) p +\n          2 * (d.h - axialExponent d.h) * p.2 * J w Amp p) / (X p * H w p)"
          }
        }
      }
