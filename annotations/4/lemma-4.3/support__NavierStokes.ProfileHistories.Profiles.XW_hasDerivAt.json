      "snippet": {
        "line": 378,
        "text": "theorem XW_hasDerivAt (h : ℝ) {p : Point} (hp : p ∈ D.carrier) :\n    HasDerivAt (fun x => x * P.W h (x, p.2))\n      (1 - 2 * axialExponent h * p.2 * P.U p -\n        coordinateFactor p.2 * parameterPartial P.U p) p.1"
      }
