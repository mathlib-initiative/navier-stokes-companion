      "snippet": {
        "line": 48,
        "text": "def powerH (F : Profile) (X : ℝ) : ℝ := Real.sqrt (2 * X) * F.powerE X, where powerE F X = powerConstant F.data * X ^ (-(1 / 2 + F.data.h))"
      }
