      "snippet": {
        "line": 21,
        "text": "def radialFlux (h lam : ℝ) (U : Field) (p : Point) : ℝ := p.1 / CoordinateAlgebra.L h p.2 * (2*p.2*U p − 2*p.2*(CoordinateAlgebra.D h + lam)*average U p − CoordinateAlgebra.d p.2 * SimilarityProfile.partialEta (average U) p)"
      }
    }
  }
