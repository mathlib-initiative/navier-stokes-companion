      "snippet": {
        "line": 277,
        "text": "def InTrueCone (p₁ p₂ A C) : Prop := 0 < A ∧ 2 < A*(1+(C/A)^2) ∧ 2 < p₁ + p₂*(C/A) ∧ A*(1+(C/A)^2) < coneBound (p₁ + p₂*(C/A)) (p₂ - p₁*(C/A))   -- same two formulas after the phase change, with t_ℓ = C/A"
      }
    }
  }
