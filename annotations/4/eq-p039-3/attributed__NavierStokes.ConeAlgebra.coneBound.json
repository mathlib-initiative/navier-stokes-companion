      "snippet": {
        "line": 17,
        "text": "def coneBound (P J : ℝ) : ℝ := P + J ^ 2 / 4 - |J| * Real.sqrt ((P - 2) / 2 + J ^ 2 / 16)   -- the paper's 𝒰 of (4.21)"
      }
