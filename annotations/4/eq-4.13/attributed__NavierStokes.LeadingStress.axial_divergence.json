          "relation": "implies",
          "snippet": {
            "line": 167,
            "text": "theorem axial_divergence (h : ℝ) {w : Point} (hw : w ∈ Ω.carrier)\n    (hX : 0 < w.1) (hL : L h w.2 ≠ 0) :\n    Real.sqrt (2 * w.1) * partialX (axial P h) w +\n        axial P h w / Real.sqrt (2 * w.1) =\n      sourceAxial P h w / L h w.2 +\n        2 * (w.1 * partialX (partialX P.U) w + partialX P.U w)"
          }
        }
