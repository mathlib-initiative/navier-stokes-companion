          "relation": "supporting",
          "snippet": {
            "line": 113,
            "text": "theorem radialPartial_of_left {D D' : RadialDomain} {F G : Field}\n    (hF : ContDiffOn ℝ ∞ F D.carrier) (hG : ContDiffOn ℝ ∞ G D'.carrier)\n    {R : ℝ} {p : Point} (hp : p ∈ D.carrier) (hq : p ∈ D'.carrier)\n    (hR : p.1 ≤ R) (he : ∀ x ≤ R, F (x, p.2) = G (x, p.2)) :\n    radialPartial F p = radialPartial G p"
          }
        }
      }
    }
