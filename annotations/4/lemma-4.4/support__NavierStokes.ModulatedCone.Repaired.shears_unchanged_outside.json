          },
          "relation": "supporting",
          "snippet": {
            "line": 1069,
            "text": "theorem shears_unchanged_outside {D D' : RadialDomain} (P : Profiles D) (Q : Profiles D')\n    (patch : FiveProfileMoments.Patch) (A : ℝ → ℝ) (c : ℝ → ModulatedHistories.Coeff)\n    (hf : P.f = ModulatedHistories.applyRepairF patch A c Q.f)\n    (hU : P.U = ModulatedHistories.applyRepairU patch A c Q.U)\n    {p : Point} (hp : p.1 ∉ Ioo patch.left patch.right) :\n    P.E p = Q.E p ∧ P.U p = Q.U p ∧\n      angularShear P.E p = angularShear Q.E p ∧\n      signedAxialShear P.E P.U p = signedAxialShear Q.E Q.U p"
          }
        }
      }
    }
  ]
