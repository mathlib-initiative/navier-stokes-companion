          },
          "relation": "supporting",
          "snippet": {
            "line": 28,
            "text": "theorem integral_equal_after {f g : ℝ → ℝ} {B X : ℝ}\n    (hB : 0 ≤ B) (hX : B ≤ X)\n    (hf : ContinuousOn f (Icc 0 X)) (hg : ContinuousOn g (Icc 0 X))\n    (hanchor : (∫ r in (0 : ℝ)..B, f r) = ∫ r in (0 : ℝ)..B, g r)\n    (htail : EqOn f g (Icc B X)) :\n    (∫ r in (0 : ℝ)..X, f r) = ∫ r in (0 : ℝ)..X, g r"
          }
        }
      }
