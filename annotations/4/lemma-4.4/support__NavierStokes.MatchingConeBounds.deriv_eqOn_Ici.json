            "text": "theorem deriv_eqOn_Ici {f g : ℝ → ℝ} {a x : ℝ} (hx : a ≤ x)\n    (hf : DifferentiableAt ℝ f x) (hg : DifferentiableAt ℝ g x)\n    (he : EqOn f g (Ici a)) : deriv f x = deriv g x"
