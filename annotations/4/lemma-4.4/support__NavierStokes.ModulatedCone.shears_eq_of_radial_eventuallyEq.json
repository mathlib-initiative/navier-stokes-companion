      "snippet": {
        "line": 514,
        "text": "theorem shears_eq_of_radial_eventuallyEq\n    {E U F V : RadialParameter → ℝ} {p : RadialParameter}\n    (hE : (fun X => E (X, p.2)) =ᶠ[𝓝 p.1] (fun X => F (X, p.2)))\n    (hU : (fun X => U (X, p.2)) =ᶠ[𝓝 p.1] (fun X => V (X, p.2))) :\n    angularShear E p = angularShear F p ∧\n      signedAxialShear E U p = signedAxialShear F V p"
      }
    }
  }
}
