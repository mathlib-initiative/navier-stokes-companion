          "relation": "supporting",
          "snippet": {
            "line": 573,
            "text": "theorem modulated_shears_eq {D : RadialDomain} (P : Profiles D) {p : Point}\n    (hp : p ∈ D.carrier) (hX : 0 < p.1) (hf : P.f p ≠ 0) :\n    ModulatedCone.angularShear P.E p = ActivationContinuation.shearA P p ∧\n      ModulatedCone.signedAxialShear P.E P.U p = ActivationContinuation.shearB P p"
          }
