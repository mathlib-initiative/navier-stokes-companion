      "snippet": {
        "line": 425,
        "text": "theorem shears_eq_on_open {E U F V : RadialParameter → ℝ} {O : Set RadialParameter}\n    (hO : IsOpen O) (hE : EqOn E F O) (hU : EqOn U V O)\n    {p : RadialParameter} (hp : p ∈ O) :\n    angularShear E p = angularShear F p ∧\n      signedAxialShear E U p = signedAxialShear F V p"
      }
    }
  }
