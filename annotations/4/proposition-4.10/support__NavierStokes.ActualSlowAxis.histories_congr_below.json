          "relation": "supporting",
          "snippet": {
            "line": 70,
            "text": "theorem histories_congr_below {D D' : ProfileHistories.RadialDomain}\n    (P : ProfileHistories.Profiles D) (Q : ProfileHistories.Profiles D')\n    {X eta : ℝ} (hX : 0 ≤ X) (hP0 : P.pressure0 eta = Q.pressure0 eta)\n    (hf : ∀ Y ∈ Icc (0 : ℝ) X, P.f (Y, eta) = Q.f (Y, eta))\n    (hu : ∀ Y ∈ Icc (0 : ℝ) X, P.U (Y, eta) = Q.U (Y, eta)) :\n    P.Ubar (X, eta) = Q.Ubar (X, eta) ∧ P.pressure (X, eta) = Q.pressure (X, eta)"
          }
        }
      }
    }
  ]
