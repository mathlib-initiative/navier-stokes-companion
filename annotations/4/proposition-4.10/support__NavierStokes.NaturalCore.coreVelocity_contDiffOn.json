        "text": "theorem coreVelocity_contDiffOn {h Λ : ℝ} {f V : ℝ × ℝ → ℝ}\n    (hh : 0 < h) (hh1 : h < 1 / 2)\n    (hf : ContDiffOn ℝ ∞ f (NaturalProfile.domain Λ))\n    (hV : ContDiffOn ℝ ∞ V (NaturalProfile.domain Λ)) :\n    ContDiffOn ℝ ∞ (coreVelocity h f V) (coreDomain h Λ)"
