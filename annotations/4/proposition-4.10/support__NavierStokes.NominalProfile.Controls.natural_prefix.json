        "line": 744,
        "text": "theorem natural_prefix\n    (hsep : ShapeTransition.separation c.shapeTime A.normalization F.data.core.P ≤ Real.exp (-8))\n    (hscale : 1 ≤ A.scale) {p : Point} (hp : p.1 ≤ 4 / A.scale) :\n    c.f p = A.natural.profile.family.f p ∧ c.U p = A.natural.profile.family.U p"
      }
