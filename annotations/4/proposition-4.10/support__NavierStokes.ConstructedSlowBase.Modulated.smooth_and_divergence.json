      "snippet": {
        "line": 885,
        "text": "theorem smooth_and_divergence (c : ℝ) (hc : 0 < c) (upper : ℝ) (B : ℕ) :\n    ContDiffOn ℝ ∞ (velocity v c hc upper B) BaseResidual.past ∧\n    ContDiffOn ℝ ∞ (pressure v c hc upper B) BaseResidual.past ∧\n    ∀ t < (1 : ℝ), ∀ x : ProblemStatement.Space,\n      ProblemStatement.spatialDivergence (velocity v c hc upper B) t x = 0"
      }
    }
  }
}
