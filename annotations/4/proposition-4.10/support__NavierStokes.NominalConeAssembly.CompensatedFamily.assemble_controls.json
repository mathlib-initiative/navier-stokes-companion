      "snippet": {
        "line": 998,
        "text": "theorem assemble_controls {D : ℝ} (hF : OutgoingProfile.Specification F D)\n    (A : AxisStage F) (c : Controls A) (hr : G.radiusFloor ≤ c.radius)\n    (hsep : c.separation ≤ Real.exp (-8))\n    (hs : ∀ eta ∈ HeatedOutgoing.parameterDomain, SmallDebt F c.debt eta) :\n    (G.assemble hF A c hr hsep hs).controls = c"
      }
    }
  }
