          "relation": "supporting",
          "snippet": {
            "line": 1108,
            "text": "theorem exists_initialTube {h j σ Λ C : ℝ} {g a : ℝ → ℝ} {cap : ℝ}\n    (hp : PressureDatum.Admissible g a cap)\n    {d : AnalyticInputs h j σ (PressureDatum.pressure g a)}\n    (F : CoefficientProfile d Λ C) (hΛ : 0 < Λ)\n    (hsmall : NaturalAxisData.SmallParameters h j) (hσ : 0 < σ) :\n    ∃ ρ : ℝ, 0 < ρ ∧ Nonempty (InitialTube (ReferenceJetBounds.referenceInput F hΛ) h\n      (PressureDatum.pressure g a) (5/Λ) (AxisHolomorphic.parameterTube parameterWindow ρ))"
          }
        }
      }
