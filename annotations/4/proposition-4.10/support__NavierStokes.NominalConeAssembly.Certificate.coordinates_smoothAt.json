          "relation": "supporting",
          "snippet": {
            "line": 1371,
            "text": "theorem Certificate.coordinates_smoothAt {F : Profile} {W : NominalProfile.Witness F}\n    (hW : Certificate W) {p : Point} (hl : activeLeft W < p.1) (hr : p.1 < activeRight W)\n    (heta : p.2 ∈ HeatedOutgoing.parameterDomain) :\n    ContDiffAt ℝ ∞ (ActivationContinuation.shearA W.profiles) p ∧\n      ContDiffAt ℝ ∞ (tilt W.profiles) p ∧\n      ContDiffAt ℝ ∞ (ReferenceBounds.p1 W.profiles F.data.h) p ∧\n      ContDiffAt ℝ ∞ (ReferenceBounds.p2 W.profiles F.data.h) p"
          }
        }
      }
