          "relation": "supporting",
          "snippet": {
            "line": 691,
            "text": "theorem held_on_patch\n    (hsep : ShapeTransition.separation c.shapeTime A.normalization F.data.core.P ≤ Real.exp (-8))\n    {eta : ℝ} (hη : eta ∈ ReferencePath.parameterInterval) :\n    ∀ x ∈ Ioo resetPatch.left resetPatch.right,\n      c.seedF (c.radius * x, eta) = A.normalization⁻¹ *\n        Real.exp (Real.log (c.radius * x / Xi) / 10 + c.initialShape eta) /\n          Real.sqrt (2 * (c.radius * x))"
          }
        }
      }
