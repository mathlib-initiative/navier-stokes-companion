          "snippet": {
            "line": 641,
            "text": "theorem shears_outside {p : Point}\n    (hout : p.1 < d.modulation.left ∨ (repairPatch W).right < p.1) :\n    ModulatedCone.angularShear v.profiles.E p = ModulatedCone.angularShear W.profiles.E p ∧\n      ModulatedCone.signedAxialShear v.profiles.E v.profiles.U p =\n        ModulatedCone.signedAxialShear W.profiles.E W.profiles.U p"
          }
