          "snippet": {
            "line": 640,
            "text": "theorem leadingFrequency_eq {h C : ℝ} {d : SlowBorelBase.Coefficients}\n    (hh : 0 < h) (hh1 : h < 1 / 2) {p : Slow} (hT : 0 < p.2.2) (hR : 0 < p.1) :\n    leadingFrequency h C d p =\n      (normalizedCoordinates h p).1 ^ (-CoordinateAlgebra.A h - 1 / 2) / C *\n        d.phi 0 (normalizedCoordinates h p).2"
          }
