          "relation": "states",
          "snippet": {
            "line": 54,
            "text": "theorem density_eq_physical (X f U : ℝ) (hX : 0 < X) :\n    densityAt X f U =\n      ![U, Real.sqrt (2 * X) * (Real.sqrt (2 * X) * f),\n        U * Real.sqrt (2 * X) * (Real.sqrt (2 * X) * f),\n        U ^ 2 - (Real.sqrt (2 * X) * f) ^ 2 / 2,\n        (Real.sqrt (2 * X) * f) ^ 2 / (2 * X)]"
          }
        }
      }
    }
