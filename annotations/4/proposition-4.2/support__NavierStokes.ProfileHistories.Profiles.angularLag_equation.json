      "snippet": {
        "line": 640,
        "text": "theorem angularLag_equation (h : ℝ) {p : Point} (hp : p ∈ D.carrier)\n    (hX : p.1 ≠ 0) (hH : P.H p ≠ 0) :\n    p.1 * deriv (fun x => P.angularLag h (x, p.2)) p.1 +\n      (1 + p.1 * radialPartial P.H p / P.H p) * P.angularLag h p =\n        P.angularSource h p / P.H p"
      }
    }
  }
