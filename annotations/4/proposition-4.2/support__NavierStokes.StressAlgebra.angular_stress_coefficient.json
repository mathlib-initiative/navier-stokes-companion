      "snippet": {
        "line": 338,
        "text": "theorem angular_stress_coefficient\n    (x R E L Qs Ex : ℝ) (hR : R ≠ 0) (hE : E ≠ 0) (hL : L ≠ 0) :\n    (E / R) * (x * Qs / L - (1 - 2 * x * Ex / E)) =\n      (E / R) * (x * Qs / L) + (2 * x * Ex - E) / R"
      }
    }
  }
}
