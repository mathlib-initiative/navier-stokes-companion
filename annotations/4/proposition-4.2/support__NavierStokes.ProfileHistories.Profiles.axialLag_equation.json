      "snippet": {
        "line": 650,
        "text": "theorem axialLag_equation (h : ℝ) {p : Point} (hp : p ∈ D.carrier) (hX : p.1 ≠ 0) :\n    p.1 * deriv (fun x => P.axialLag h (x, p.2)) p.1 + P.axialLag h p =\n      P.axialSource h p"
