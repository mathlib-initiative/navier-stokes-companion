            "line": 55,
            "text": "theorem modulated_mean_fields {p : Inner}\n    (hp : p.1 ∈ ReservedPatches.window F W.controls.radius .mean) (heta : |p.2| ≤ 1) :\n    v.profiles.U p = 0 ∧\n      v.profiles.E p = ReservedPatches.xAmplitude F W.controls.radius p.2 *\n        p.1 ^ (-(1 / 2 + F.data.core.lam))"
