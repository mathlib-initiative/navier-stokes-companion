            "text": "theorem stress_inner_transverse (F τ p₁ p₂ a c : ℝ) (ha : a ≠ 0) :\n    ⟪τ • !₂[p₁ - a, p₂ - c], PrimaryRepresentatives.transverseDirection (F • !₂[-a, -c])⟫_ℝ =\n      (τ * F * a / ‖F • !₂[-a, -c]‖) * (p₂ - p₁ * (c / a))"
          }
