          "relation": "implies",
          "snippet": {
            "line": 299,
            "text": "theorem physical_radius {h : ℝ} (hh : 0 < h) (hh1 : h < 1 / 2)\n    {p : SimilarityProfile.PhysicalPoint} (hp : p.1 < 1) :\n    Real.sqrt (2 * p.2.1) = SimilarityProfile.q h p ^ (1 / (2 : ℝ)) *\n      Real.sqrt (2 * (inner h p).1)"
          }
        }
