      "snippet": {
        "line": 26,
        "text": "theorem stress_eq {D : RadialDomain} (P : Profiles D) (h : ℝ) {p : Point}\n    (hX : 0 < p.1) (hf : P.f p ≠ 0) :\n    stress P h p = P.f p •\n      (ReferenceBounds.p1 P h p - ActivationContinuation.shearA P p,\n        ReferenceBounds.p2 P h p - ActivationContinuation.shearB P p)"
      }
    }
  }
