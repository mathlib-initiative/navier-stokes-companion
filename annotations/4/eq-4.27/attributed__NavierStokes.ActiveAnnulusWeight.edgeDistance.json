      "snippet": {
        "line": 25,
        "text": "noncomputable def edgeDistance (a b y : ℝ) : ℝ := min 1 (min (y-a) (b-y))  -- with y = log X, a = log X_a, b = log X_b this is min{1, log(X/X_a), log(X_b/X)} = δ"
      }
