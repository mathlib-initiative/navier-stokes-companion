        "line": 1137,
        "text": "theorem physical_jet_bound (hcone : FullTrueCone v) (n : ℕ) : ∃ C : ℝ, 0 < C ∧ ∃ N : ℕ, ∀ eta ∈ Icc (-1) 1, ∀ X ∈ Ioo (activeLeft W) (activeRight W), ‖iteratedFDeriv ℝ n (fun p => stress v.profiles F.data.h (p.2, p.1)) (eta, X)‖ ≤ C * zeta v X / distance v X ^ N"
      }
