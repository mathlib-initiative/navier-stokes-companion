          "snippet": {
            "line": 1592,
            "text": "theorem actual_input_cover (l : SignedLabel B N0) (n : ℕ) {x : ActualPrimary.FullPoint}\n    (hx : x ∈ fullStrip.domain) :\n    (∃ k, x ∈ controlCell n (l, k)) ∨\n      ((cutCoefficients l).amplitude n =ᶠ[𝓝 x] fun _ => 0) ∧\n      ((cutCoefficients l).pressure n =ᶠ[𝓝 x] fun _ => 0)"
          }
        }
