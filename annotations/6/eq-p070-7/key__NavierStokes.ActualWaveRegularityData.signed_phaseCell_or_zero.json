          "snippet": {
            "line": 561,
            "text": "theorem signed_phaseCell_or_zero (l : Index B N0) (n : ℕ) (k : Frequency)\n    {x : FullPoint} (hx : x ∈ ActualSignedStageControls.fullStrip.domain) :\n    x ∈ ActualSignedStageControls.phaseCell l n k ∨\n      (ActualSignedStageControls.cutoff l k n =ᶠ[𝓝 x] fun _ => 0) ∨\n      (ActualSignedStageControls.mask l k n =ᶠ[𝓝 x] fun _ => 0)"
          }
