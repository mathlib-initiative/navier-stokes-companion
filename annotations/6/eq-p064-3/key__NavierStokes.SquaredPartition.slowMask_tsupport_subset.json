            "line": 588,
            "text": "theorem slowMask_tsupport_subset {n : ℕ} (hn : 1 ≤ n) (k : SlotColoring.Grid) :\n    tsupport (slowMask n k) ⊆ Set.pi univ (fun j =>\n      Icc (nativeSpacing n * k j - nativeSpacing n) (nativeSpacing n * k j + nativeSpacing n))"
          }
        }
