          "snippet": {
            "line": 209,
            "text": "theorem auxiliary_directional_eq (F : Lift → ℝ) (p : Lift) (v : Plane) :\n    fderiv ℝ F p ((0, 0), v) =\n      v.1 * fderiv ℝ F p ((0, 0), (1, 0)) +\n        v.2 * fderiv ℝ F p ((0, 0), (0, 1))"
          }
        }
      }
    }
