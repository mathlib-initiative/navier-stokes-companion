          "snippet": {
            "line": 233,
            "text": "theorem timeOp_expanded (vt : Plane) (F : Lift → ℝ) (p : Lift) :\n    timeOp vt F p = fderiv ℝ F p ((0, 1), (0, 0)) +\n      (vt.1 * fderiv ℝ F p ((0, 0), (1, 0)) +\n        vt.2 * fderiv ℝ F p ((0, 0), (0, 1)))"
          }
        }
      }
    }
  ]
