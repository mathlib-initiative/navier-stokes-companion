          "snippet": {
            "line": 266,
            "text": "theorem graph_directions_diophantine (k : ℤ × ℤ) (hk : k ≠ 0) :\n    (1 / 6 : ℝ) / (1 + frequencyLength k.1 k.2) ≤\n        |(k.1 : ℝ) + (1 - Real.sqrt 2) * (k.2 : ℝ)| ∧\n      (1 / 6 : ℝ) / (1 + frequencyLength k.1 k.2) ≤\n        |(Real.sqrt 2 - 1) * (k.1 : ℝ) + (k.2 : ℝ)|"
          }
        }
      }
    }
  ]
