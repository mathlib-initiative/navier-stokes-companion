            "line": 1302,
            "text": "theorem exists_coarsest_band (h : ℝ) (hh : 0 ≤ h) (levels : Finset ℕ)\n    (hne : levels.Nonempty) (hpos : ∀ n ∈ levels, 1 ≤ n)\n    (hspan : ∀ n ∈ levels, ∀ m ∈ levels, n ≤ m + 4) :\n    ∃ c ∈ levels, ∀ n ∈ levels,\n      ChartScales.nativeIndex h c ≤ ChartScales.nativeIndex h n ∧\n        ChartScales.nativeIndex h n - ChartScales.nativeIndex h c ≤ SlotColoring.nativeGap h"
          }
        }
      }
