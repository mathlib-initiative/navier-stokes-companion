      "snippet": {
        "line": 246,
        "text": "theorem absoluteInverse_coverMap {f : Plane → ℂ} (hf : ContDiff ℝ ∞ f)\n    (hp : SmoothFourierData.UnitPeriodic f) (hm : TorusAverages.squareAverage f = 0) (n : ℕ) :\n    absoluteInverse (fun z => f (coverMap n z)) =\n      fun z => (ChartScales.Tg ^ n)⁻¹ • absoluteInverse f (coverMap n z)"
      }
