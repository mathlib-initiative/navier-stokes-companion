          },
          "relation": "states",
          "snippet": {
            "line": 404,
            "text": "theorem logWeight_formula {a b X : ℝ} (ha : 0 < a) (hX : X ∈ Ioo a b)\n    (cL cR : ℝ) (m : ℕ) :\n    logWeight cL cR a b m X =\n      Real.exp (-cL / (Real.log (X / a)) ^ 2 - cR / (Real.log (b / X)) ^ 2) /\n        (min 1 (min (Real.log (X / a)) (Real.log (b / X)))) ^ m"
          }
        }
      }
    }
  ]
