        "text": "theorem closedWindow_adjacency {d : ℝ} {l k : SlotColoring.Label} {x : WindowPoint}\n    (hl : 1 ≤ l.1) (hk : 1 ≤ k.1) (hne : l ≠ k)\n    (hxl : x ∈ closedWindow d l) (hxk : x ∈ closedWindow d k) : SlotColoring.Adj d l k"
