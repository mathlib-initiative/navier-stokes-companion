            "text": "theorem angularMean_field {α : Type*} (c : Coefficients α) (k : ℝ) (Φ : α → ℝ)\n    {kp : ℤ} (hkp : kp ≠ 0) (x : α) :\n    angularMean (fun θ => field c k Φ kp (x, θ)) = c 0 x"
