      "snippet": {
        "line": 70,
        "text": "theorem count_of_band_index_bounds {s : Set Label} (F : Finset ℕ)\n    (c : ℕ → Grid) (K : Fin 3 → ℕ)\n    (hs : ∀ L ∈ s, L.1 ∈ F ∧ ∀ j, |L.2.1 j - c L.1 j| ≤ (K j : ℤ)) :\n    s.Finite ∧ s.ncard ≤ F.card * (2 * ∏ j, (2 * K j + 1))"
      }
    }
  }
}
