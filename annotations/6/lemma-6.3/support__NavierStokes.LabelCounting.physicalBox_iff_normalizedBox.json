      "snippet": {
        "line": 305,
        "text": "theorem physicalBox_iff_normalizedBox (D : ℝ) {n : ℕ} (_hn : 1 ≤ n)\n    (k : Grid) (σ : Bool) (x : Position) :\n    x ∈ physicalBox D (n, k, σ) ↔\n      slowCoordinates D n x ∈ normalizedBox 2 (n, k, σ)"
      }
