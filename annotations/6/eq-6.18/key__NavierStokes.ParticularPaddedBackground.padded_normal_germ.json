            "line": 107,
            "text": "theorem padded_normal_germ {i : CopyIndex B N0} {n : ℕ} {x : ActualPrimary.FullPoint}\n    (hx : x ∈ fullStrip.domain) (hc : x ∈ paddedCell n i) :\n    chartNormal i.1 n =ᶠ[𝓝 x] fun y => normalScale i.1 n •\n      (jointPhase (B := B) (N0 := N0)).normal i.1\n        ((fullCopy i.1 n i.2 y).1, (fullCopy i.1 n i.2 y).2.2)"
          }
