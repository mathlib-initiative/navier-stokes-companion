            "line": 361,
            "text": "theorem liftedSupport_disjoint_of_separation (level n : ℕ) (S T : Set Plane)\n    (hsep : ∀ x ∈ S, ∀ y ∈ T, ¬ torusEq ((cover ^ n) x) y) :\n    Disjoint (liftedSupport level S) (liftedSupport (level + n) T)"
