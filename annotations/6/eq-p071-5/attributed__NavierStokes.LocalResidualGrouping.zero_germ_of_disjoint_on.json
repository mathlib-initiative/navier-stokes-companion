            "text": "theorem zero_germ_of_disjoint_on {U : Set D} {u v : D → ComplexVector}\n    (hd : Disjoint (U ∩ tsupport u) (U ∩ tsupport v)) {x : D}\n    (hx : x ∈ U) (hu : u x ≠ 0) : v =ᶠ[𝓝 x] fun _ => 0"
