          "relation": "states",
          "snippet": {
            "line": 241,
            "text": "theorem angularMean_product {α : Type*} (c d : Coefficients α) (k : ℝ) (Φ : α → ℝ)\n    {kp : ℤ} (hkp : kp ≠ 0) (x : α) :\n    angularMean (fun θ => field c k Φ kp (x, θ) * field d k Φ kp (x, θ)) =\n      ∑ j ∈ c.support, c j x * d (-j) x"
          }
        }
