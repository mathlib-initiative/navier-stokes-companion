          "snippet": {
            "line": 133,
            "text": "theorem Atlas.physical_eq {h degree : ℝ} {N Δ : ℕ} (A : Atlas h N Δ)\n    {U : Set Plane} {f : Scalar} (H : A.OverlapLaw U degree f)\n    {z : Point} {n : ℕ} (hn : A.Valid U z n) :\n    A.physical U degree f z = ChartScales.Q n ^ (-degree) * f n (A.chart n z)"
          }
