      "snippet": {
        "line": 189,
        "text": "def pointwiseLabels (D A q : ℝ) (x : Position) : Set Label := {L | 1 ≤ L.1 ∧ q ∈ tsupport (dyadicMask (L.1 : ℤ)) ∧ slowCoordinates D L.1 x ∈ normalizedBox A L}  -- second conjunct is the band condition, q a free real"
      }
