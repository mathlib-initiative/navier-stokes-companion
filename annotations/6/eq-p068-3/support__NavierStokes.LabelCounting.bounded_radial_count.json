          "relation": "uses",
          "snippet": {
            "line": 173,
            "text": "theorem bounded_radial_count (A : ℝ) {I : Set ℝ} (hI : Bornology.IsBounded I) :\n    ∃ C > 0, ∀ n : ℕ, 1 ≤ n → ∀ Z T : ℝ,\n      (relevantLabels n A (radialSlice I Z T)).Finite ∧\n        ((relevantLabels n A (radialSlice I Z T)).ncard : ℝ) ≤ C * ChartScales.S n ^ 3"
          }
        }
      }
    }
  ]
