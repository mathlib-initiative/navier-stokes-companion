      "snippet": {
        "line": 173,
        "text": "theorem bounded_radial_count (A : ℝ) (hI : Bornology.IsBounded I) : ∃ C > 0, ∀ n : ℕ, 1 ≤ n → ∀ Z T : ℝ, (relevantLabels n A (radialSlice I Z T)).Finite ∧ ((relevantLabels n A (radialSlice I Z T)).ncard : ℝ) ≤ C * ChartScales.S n ^ 3"
      }
