          "snippet": {
            "line": 164,
            "text": "theorem compact_chart_count (A : ℝ) {B : Set Position} (hB : IsCompact B) :\n    ∃ C > 0, ∀ n : ℕ, 1 ≤ n →\n      (relevantLabels n A B).Finite ∧\n        ((relevantLabels n A B).ncard : ℝ) ≤ C * ChartScales.S n ^ 9"
          }
        }
      }
    }
