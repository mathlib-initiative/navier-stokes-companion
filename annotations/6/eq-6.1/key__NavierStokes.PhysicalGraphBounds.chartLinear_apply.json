          "snippet": {
            "line": 404,
            "text": "@[simp] theorem chartLinear_apply (h : ℝ) (n : ℕ) (p : SpaceTime) :\n    chartLinear h n p = (-ChartScales.Q n ^ (-1 : ℝ) * p.1,\n      (ChartScales.Q n ^ (-(1 / 2 : ℝ)) * p.2 0,\n        (ChartScales.Q n ^ (-(1 / 2 : ℝ)) * p.2 1,\n          ChartScales.Q n ^ (-CoordinateAlgebra.D h) * p.2 2)))"
          }
        }
      }
    }
