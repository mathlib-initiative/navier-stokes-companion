          "snippet": {
            "line": 89,
            "text": "theorem phase_dT (ε p pz x0 : ℝ) (F G : Slow → ℝ) (q : Slot)\n    (hF : DifferentiableAt ℝ F q.1) (hG : DifferentiableAt ℝ G q.1) :\n    fderiv ℝ (phase ε p pz x0 F G) q eT =\n      -q.2.2 * (p * slowT F q.1 + pz * slowT G q.1)"
          }
        }
      }
