            "text": "theorem coefficientScale_square {epsilon referenceEpsilon velocityScale : ℝ}\n    (he : 0 < epsilon) (hr : 0 ≤ referenceEpsilon) :\n    coefficientScale epsilon referenceEpsilon velocityScale ^ 2 =\n      velocityScale ^ 2 * referenceEpsilon / epsilon"
