      "snippet": {
        "line": 725,
        "text": "theorem zeroExtension_signed_identity {U : Set E} {g r : E × ℝ → ℝ}\n    (hpos : ∀ p ∈ U ×ˢ Ioi (0 : ℝ), 0 < g p) {p : E × ℝ} (hp : p.1 ∈ U) :\n    2 * FlatZeroExtension.zeroExtension (fun p => Real.sqrt (g p)) p *\n      FlatZeroExtension.zeroExtension (fun p => r p / (2 * Real.sqrt (g p))) p =\n      FlatZeroExtension.zeroExtension r p"
      }
    }
  }
