        "line": 469,
        "text": "theorem increment_jets {R : I → ℕ → D → Vec2} {β : ℝ}\n    (hR : ∀ a, LocalJets s (fun _ x => s.zeta x) β K (fun n i x => R i n x a)) (j : Fin 2) :\n    LocalJets s (fun _ x => Real.sqrt (s.zeta x)) β K\n      (fun n i x => SignedCovariance.increment (H i n x) (T i n x) (R i n x) j)"
      }
