          "snippet": {
            "line": 70,
            "text": "theorem phase_dR (ε p pz x0 : ℝ) (F G : Slow → ℝ) (q : Slot)\n    (hF : DifferentiableAt ℝ F q.1) (hG : DifferentiableAt ℝ G q.1) :\n    fderiv ℝ (phase ε p pz x0 F G) q eR =\n      x0 - q.2.2 * (p * slowR F q.1 + pz * slowR G q.1)"
          }
        }
      }
