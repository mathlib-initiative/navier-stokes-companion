      "snippet": {
        "line": 450,
        "text": "theorem finite_jet_bounds {s : StripData E} {f : ℕ → E → ℝ}\n    (hf : UnweightedClass s 1 f) (m : ℕ) :\n    ∃ C : ℝ, 0 ≤ C ∧ ∃ p : ℕ, ∀ n x, x ∈ s.domain → ∀ j ≤ m,\n      ‖iteratedFDeriv ℝ j (f n) x‖ ≤ C * s.epsilon n * s.growth n x ^ p"
      }
    }
  }
}
