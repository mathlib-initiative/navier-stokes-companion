          "snippet": {
            "line": 840,
            "text": "theorem modal_energy_le {lam e11 e12 e21 e22 ε : ℝ} (hlam : 0 ≤ lam) (damping : ℝ)\n    (he11 : |e11| ≤ ε) (he12 : |e12| ≤ ε) (he21 : |e21| ≤ ε) (he22 : |e22| ≤ ε)\n    (z : Plane) :\n    ⟪z, GrowingMode.modalOperator lam damping e11 e12 e21 e22 z⟫_ℝ ≤\n      (lam - damping + 4 * ε) * ‖z‖ ^ 2"
          }
        }
      }
    }
