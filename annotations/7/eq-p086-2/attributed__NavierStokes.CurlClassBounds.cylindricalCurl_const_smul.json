            "line": 389,
            "text": "theorem cylindricalCurl_const_smul (R : D → ℝ) (Vr Vθ Vz : D → D) (c : ℂ)\n    {B : D → ComplexVector} {x : D} (hB : ∀ i, DifferentiableAt ℝ (fun y => B y i) x) :\n    cylindricalCurl R Vr Vθ Vz (fun y => c • B y) x = c • cylindricalCurl R Vr Vθ Vz B x"
          }
