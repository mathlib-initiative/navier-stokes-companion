      "snippet": {
        "line": 269,
        "text": "noncomputable def curlRemainder (K : ℝ) (R : D → ℝ) (Vr Vθ Vz : D → D) (B : D → ComplexVector) (x : D) : ComplexVector := (1 / K) • (Complex.I • cylindricalCurl R Vr Vθ Vz B x)  -- applied to B = coefficient, i.e. r_m = (i/K) curl_*((km/i)·C_m) = curl_* C_m"
      }
