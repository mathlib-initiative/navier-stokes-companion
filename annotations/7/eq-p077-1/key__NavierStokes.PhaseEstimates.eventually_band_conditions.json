          "snippet": {
            "line": 1038,
            "text": "theorem eventually_band_conditions (h : ℝ) (hh : 0 < h) :\n    ∀ᶠ n : ℕ in atTop,\n      1 ≤ ChartScales.S n ∧\n      ChartScales.S n ^ 2 * ChartScales.epsilon h n ^ 2 ≤ 1 ∧\n      ChartScales.S n ^ 2 / (ChartScales.carrier h n : ℝ) ≤ 1 ∧\n      ChartScales.epsilon h n * ChartScales.S n ^ 2 ≤ 1"
          }
        }
      }
