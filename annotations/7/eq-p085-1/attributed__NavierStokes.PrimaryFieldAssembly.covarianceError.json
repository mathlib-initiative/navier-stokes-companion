        "text": "noncomputable def covarianceError (V R : Plane → ℝ → Vector) (i : Fin 2) (Y : Plane) (θ : ℝ) : ℝ := V Y θ 0 * R Y θ i.succ + R Y θ 0 * V Y θ i.succ + R Y θ 0 * R Y θ i.succ"
