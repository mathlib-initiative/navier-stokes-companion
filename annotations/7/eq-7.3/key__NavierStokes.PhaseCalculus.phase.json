      "snippet": {
        "line": 44,
        "text": "def phase (ε p pz x0 : ℝ) (F G : Slow → ℝ) (q : Slot) : ℝ := p * q.2.1 + (pz / ε) * q.1.2.1 + x0 * q.1.1 - q.2.2 * (p * F q.1 + pz * G q.1)"
