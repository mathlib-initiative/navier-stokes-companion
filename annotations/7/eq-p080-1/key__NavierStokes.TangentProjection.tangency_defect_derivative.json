          "snippet": {
            "line": 93,
            "text": "theorem tangency_defect_derivative {n t : ℝ → E} {n' : E} {x : ℝ}\n    {Kt f : E} {δ : ℝ} (hn0 : n x ≠ 0)\n    (hn : HasDerivAt n n' x)\n    (ht : HasDerivAt t (projectedRhs (n x) n' (t x) Kt f δ) x) :\n    HasDerivAt (fun y => ⟪n y, t y⟫_ℝ) (-δ * ⟪n x, t x⟫_ℝ) x"
          }
        }
      }
    }
  ]
