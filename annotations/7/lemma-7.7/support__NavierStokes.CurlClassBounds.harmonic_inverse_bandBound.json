        "text": "theorem harmonic_inverse_bandBound (s : StripData D) (j : ℕ → ℤ) (hj : ∀ n, j n ≠ 0) :\n    BandBound s (1 / 2) (fun n => 1 / (carrierFrequency s n * (j n : ℝ)))"
