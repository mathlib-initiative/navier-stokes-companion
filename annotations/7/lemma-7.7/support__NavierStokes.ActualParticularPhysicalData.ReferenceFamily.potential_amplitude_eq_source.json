        "line": 841,
        "text": "theorem potential_amplitude_eq_source (N : ℕ) (i : Fin 3) (k : Copy)\n    (I : PhysicalWaveSum.WaveIndex N) (x : LiftPoint) :\n    (F.potentialFamily N i).amplitude k I x = ChartScales.Q I.1.val.1 ^ (-h) •\n      CartesianCopySource.rotatedSource (F.nativePotential N) (k, I) I.1.val.1 x i"
      }
