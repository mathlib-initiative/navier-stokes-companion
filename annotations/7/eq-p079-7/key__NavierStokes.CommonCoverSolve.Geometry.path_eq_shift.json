            "text": "theorem path_eq_shift (k : Frequency) (Y : Plane) (eta : ℝ) :\n    g.path k Y eta = Y + (coverPower g.gap).symm\n      ((eta - (g.coordinates k Y).2) • g.basis (0, 1))"
