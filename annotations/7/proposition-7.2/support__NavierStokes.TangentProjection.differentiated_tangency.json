      "snippet": {
        "line": 82,
        "text": "theorem differentiated_tangency {n t : ℝ → E} {n' t' : E} {x : ℝ}\n    (hn : HasDerivAt n n' x) (ht : HasDerivAt t t' x)\n    (htangent : ∀ y, ⟪n y, t y⟫_ℝ = 0) :\n    ⟪n x, t'⟫_ℝ = -⟪n', t x⟫_ℝ"
      }
