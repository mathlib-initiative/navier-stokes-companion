            "text": "theorem copySolve_preserves_slow_support {U : Set P}\n    (hf : ∀ p ∉ U, ∀ Y, d.source (p, Y) = 0) (k : Frequency) {p : P} (hp : p ∉ U)\n    (Y : Plane) : d.copySolve g hab k (p, Y) = 0"
