            "line": 377,
            "text": "theorem copySolve_preserves_transverse_support (k : Frequency) {S : Set ℝ} (p : P)\n    (hf : ∀ xi ∉ S, ∀ eta ∈ Icc a b, d.source (p, g.point k (xi, eta)) = 0)\n    (Y : Plane) (hY : (g.coordinates k Y).1 ∉ S) : d.copySolve g hab k (p, Y) = 0"
          }
