      "snippet": {
        "line": 103,
        "text": "def phaseNormal (ε p pz x0 : ℝ) (F G : Slow → ℝ) (q : Slot) : Vec3 := !₂[fderiv ℝ (phase …) q eR, fderiv ℝ (phase …) q eTheta / q.1.1, ε * fderiv ℝ (phase …) q eZ]  -- docstring: \"the cylindrical chart gradient (∂R Φ, R⁻¹∂θ Φ, ε∂Z Φ)\""
      }
    }
  }
