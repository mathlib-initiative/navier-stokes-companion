        "text": "noncomputable def netGrowth (lam u s : ℝ) : ℝ := lam / Real.sqrt (1 + s ^ 2) - lam * (1 + s ^ 2) / ((1 + u ^ 2) * Real.sqrt (1 + u ^ 2))"
