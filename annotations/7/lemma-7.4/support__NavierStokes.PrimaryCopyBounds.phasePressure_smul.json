      "snippet": {
        "line": 650,
        "text": "theorem phasePressure_smul (p : PhaseConstruction U)\n    (χ : ι → D → PhaseCalculus.Slow × ℝ) (frequency : ι → ℝ)\n    (a : ι → D → ℝ) (u : ι → D → ProblemStatement.Space) (i : ι) (x : D) :\n    phasePressure p χ frequency (fun i x => a i x • u i x) i x =\n      a i x • phasePressure p χ frequency u i x"
      }
    }
  }
