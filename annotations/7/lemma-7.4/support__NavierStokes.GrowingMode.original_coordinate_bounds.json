      "snippet": {
        "line": 430,
        "text": "theorem original_coordinate_bounds {p q h r : ℝ}\n    (hp : 0 < p) (hr : 0 ≤ r) (hrhalf : r ≤ 1 / 2) (hcone : |q| ≤ r * p) :\n    p / 2 ≤ p + q ∧ p + q ≤ 3 * p / 2 ∧\n      |h * (p - q) / (p + q) - h| ≤ 4 * |h| * r"
      }
    }
  }
}
