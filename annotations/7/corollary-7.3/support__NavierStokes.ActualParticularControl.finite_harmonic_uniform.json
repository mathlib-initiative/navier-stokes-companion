        "text": "theorem finite_harmonic_uniform\n    (s : StripData E) (w : Label → ℕ → E → ℝ) (α : ℝ)\n    (H : Finset ℤ) (f : ℤ → Label → ℕ → E → V)\n    (hf : ∀ j ∈ H, UniformClass s w α (f j)) :\n    UniformClass s (fun l : Label × {j : ℤ // j ∈ H} => w l.1) α\n      (fun l => f l.2.1 l.1)"
